FROM --platform=linux/amd64 golang@sha256:c6a5b9308b3f3095e8fde83c8bf4d68bd101fce606c1a0a1394522542509dda9
ARG BASE_COMMIT=3ec4bd76ac821f612a12f50c5f4257e7ddf123db
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV CGO_ENABLED=1
ENV GOFLAGS=-buildvcs=false
ENV GOCACHE=/workspace/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOTOOLCHAIN=local
ENV SOURCE_DATE_EPOCH=0
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends tmux=3.3a-3 build-essential ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN printf 'export CGO_ENABLED="1"\nexport GOFLAGS="-buildvcs=false"\nexport GOCACHE="/workspace/.cache/go-build"\nexport GOMODCACHE="/go/pkg/mod"\nexport GOTOOLCHAIN="local"\nexport PATH="/usr/local/go/bin:/go/bin:$PATH"\n' > /etc/profile.d/00-toolchain.sh && chmod 0644 /etc/profile.d/00-toolchain.sh
RUN useradd -m -u 1000 -s /bin/bash agent 2>/dev/null || true && git config --system --add safe.directory /app
RUN git init -q /app && cd /app && git remote add origin https://github.com/florianl/go-tc.git && git fetch --depth 1 origin "$BASE_COMMIT" && git checkout -q FETCH_HEAD && git submodule update --init --recursive --depth 1 2>/dev/null || true
RUN cd /app && test "$(git rev-parse HEAD)" = "$BASE_COMMIT"
WORKDIR /app
RUN mkdir -p /workspace/.cache/go-build /go/pkg/mod
RUN go mod download all
RUN go build ./... && chown -R agent:agent /app /workspace/.cache/go-build /go/pkg/mod 2>/dev/null || true
LABEL org.opencontainers.image.source="https://github.com/florianl/go-tc" org.opencontainers.image.revision="aef39beda523a250e2c966c90fe81fdbb10ec0b9"
RUN cd /app && git checkout -- . && test -z "$(git status --porcelain --untracked-files=no)"
RUN GOFLAGS= GOPROXY=https://proxy.golang.org,direct GOSUMDB=sum.golang.org go install github.com/ctrf-io/go-ctrf-json-reporter/cmd/go-ctrf-json-reporter@v0.1.0 && command -v go-ctrf-json-reporter
RUN gopath="$(go env GOPATH)" && chown root:root "$gopath" && chmod 0755 "$gopath" && chown -R root:root "$gopath/bin" && chmod 0755 "$gopath/bin" && [ "$(stat -c '%u %a' "$gopath/bin")" = "0 755" ]
RUN id -u agent >/dev/null 2>&1 || useradd -m -s /bin/bash agent 2>/dev/null || adduser -D -s /bin/sh agent 2>/dev/null || adduser --disabled-password --gecos "" agent; id -u agent >/dev/null
RUN chown -R agent:agent /app; [ -d /workspace/.cache/go-build ] && chown -R agent:agent /workspace/.cache/go-build; [ -d /go/pkg/mod ] && chown -R agent:agent /go/pkg/mod; [ "$(stat -c '%U' /app)" = "agent" ]
ENV CGO_ENABLED="1"
ENV GOCACHE="/workspace/.cache/go-build"
ENV GOFLAGS="-buildvcs=false"
ENV GOMODCACHE="/go/pkg/mod"
ENV GOTOOLCHAIN="local"
CMD ["bash"]
