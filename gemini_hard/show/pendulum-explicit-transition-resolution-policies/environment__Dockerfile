FROM python@sha256:94c362db08c5b38857943d31b10558ff1856e918605c474d205d72a534929d4e
ARG BASE_COMMIT=0d71391ab2b617b2e86d15c926e6cde9fddc5676
ENV DEBIAN_FRONTEND=noninteractive
ENV CI="1"
ENV CARGO_HOME="/opt/rust/cargo"
ENV RUSTUP_HOME="/opt/rust/rustup"
ENV PATH="/opt/rust/cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV POETRY_VIRTUALENVS_CREATE="false"
RUN apt-get update && apt-get install -y --no-install-recommends bash build-essential ca-certificates curl gdb git jq less procps strace tmux=3.3a-3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git init -q . && git remote add origin https://github.com/python-pendulum/pendulum.git && git fetch --depth 1 origin "$BASE_COMMIT" && git checkout -q FETCH_HEAD
RUN test "$(git rev-parse HEAD)" = "$BASE_COMMIT"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.85.0
RUN pip install --no-cache-dir maturin==1.7.6
RUN pip install --no-cache-dir --no-build-isolation -e .
RUN git config --system --add safe.directory /app
RUN pip install --no-cache-dir poetry==2.2.1 pytest==7.4.4 pytest-benchmark==4.0.0 time-machine==3.2.0
RUN id -u agent >/dev/null 2>&1 || useradd -m -s /bin/bash agent 2>/dev/null || adduser -D -s /bin/sh agent 2>/dev/null || adduser --disabled-password --gecos "" agent; id -u agent >/dev/null
RUN chown -R agent:agent /app; [ -d /workspace/.cache/go-build ] && chown -R agent:agent /workspace/.cache/go-build; [ -d /go/pkg/mod ] && chown -R agent:agent /go/pkg/mod; [ "$(stat -c '%U' /app)" = "agent" ]
CMD ["bash"]
