vars: {d2-config: {layout-engine: elk; pad: 16}}
classes: {
  band: {style: {fill: "#fbf9f4"; stroke: "#11484e"; stroke-width: 1; font-color: "#446b6e"; border-radius: 0; font-size: 13; bold: true}}
  card: {width: 250; height: 66; style: {fill: "#ffffff"; stroke: "#cfcac2"; font-color: "#11484e"; border-radius: 2; font-size: 13; bold: false}}
  svc: {width: 190; height: 62; style: {fill: "#ffffff"; stroke: "#11484e"; font-color: "#11484e"; border-radius: 2; font-size: 13; bold: false}}
  step: {width: 190; height: 62; style: {fill: "#ffffff"; stroke: "#11484e"; font-color: "#11484e"; border-radius: 14; font-size: 13; bold: false}}
  goal: {width: 300; height: 66; style: {fill: "#11484e"; stroke: "#11484e"; font-color: "#ffffff"; border-radius: 2; font-size: 13; bold: true}}
  check: {width: 250; height: 66; style: {fill: "#d4e8e3"; stroke: "#1f6f6a"; font-color: "#11484e"; border-radius: 2; font-size: 13; bold: false}}
  problem: {width: 760; height: 70; style: {fill: "#fdecea"; stroke: "#f44029"; font-color: "#c83220"; border-radius: 2; font-size: 14; stroke-dash: 3; bold: false}}
}
(** -> **)[*].style: {stroke: "#11484e"; font-color: "#625f5d"; font-size: 12; stroke-width: 1}

grid-columns: 1
grid-gap: 18
problem: "The problem: Only a compiled tool and its user docs exist;\nthe source code is not available" {class: problem; icon: /private/tmp/claude-502/-Users-carlos-code-sdlc-final-samples/aea3879a-4aa2-43de-8a41-3a000a1b1db3/scratchpad/d2/icons/tb-alert-triangle.svg; icon.near: center-left}
gets: "WHAT THE AGENT RECEIVES" {class: band; grid-columns: 3; grid-gap: 14
  r0: "Reference tool\n(run it, cannot read it)" {class: card; icon: /private/tmp/claude-502/-Users-carlos-code-sdlc-final-samples/aea3879a-4aa2-43de-8a41-3a000a1b1db3/scratchpad/d2/icons/tb-binary-tree.svg; icon.near: center-left; label.near: center-center}
  r1: "User documentation\n(4 reference pages)" {class: card; icon: /private/tmp/claude-502/-Users-carlos-code-sdlc-final-samples/aea3879a-4aa2-43de-8a41-3a000a1b1db3/scratchpad/d2/icons/tb-book.svg; icon.near: center-left; label.near: center-center}
  r2: "Go, Rust and C/C++ toolchains" {class: card; icon: /private/tmp/claude-502/-Users-carlos-code-sdlc-final-samples/aea3879a-4aa2-43de-8a41-3a000a1b1db3/scratchpad/d2/icons/tb-terminal-2.svg; icon.near: center-left; label.near: center-center}
}
job: "THE AGENT'S JOB" {class: band; direction: right
  j0: "1. Run the reference on test inputs" {class: step}
  j1: "2. Infer the rules it applies" {class: step}
  j0 -> j1
  j2: "3. Write a new implementation" {class: step}
  j1 -> j2
  j3: "4. Compare outputs side by side" {class: step}
  j2 -> j3
}
end: "" {grid-columns: 2; grid-gap: 18; style: {fill: transparent; stroke: transparent}
  out: "DELIVERABLE" {class: band; grid-columns: 1; grid-gap: 10
    d0: "Source project + compile.sh\nthat builds ./executable" {class: goal}
  }
  verify: "HOW IT IS CHECKED" {class: band; grid-columns: 1; grid-gap: 10
    c0: "Hidden behavior tests\n(outputs, exit codes, files)" {class: check; icon: /private/tmp/claude-502/-Users-carlos-code-sdlc-final-samples/aea3879a-4aa2-43de-8a41-3a000a1b1db3/scratchpad/d2/icons/tb-test-pipe.svg; icon.near: center-left; label.near: center-center}
    c1: "Must match the reference\non every test" {class: check; icon: /private/tmp/claude-502/-Users-carlos-code-sdlc-final-samples/aea3879a-4aa2-43de-8a41-3a000a1b1db3/scratchpad/d2/icons/tb-scale.svg; icon.near: center-left; label.near: center-center}
  }
}