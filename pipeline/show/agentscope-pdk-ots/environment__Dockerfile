# syntax=docker/dockerfile:1
# agentscope-pdk-ots. /workdir carries agentscope-ai/agentscope at 4891ba7a448d6767985639583ba3d43c35a35ee3
# with its documentation curation and the selected implementation drift already applied; the tree is shipped
# in this build context so the image needs no repository fetch.
# Runtime has no network: everything solve-time and grade-time is installed here with exact, hash-pinned
# versions (requirements.txt: the project's `[dev]` extra, which the colleague original's image installed).
FROM python@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 PIP_NO_CACHE_DIR=1
ENV UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=never UV_PYTHON=/opt/venv/bin/python
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=0
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/workdir/src
ENV SOURCE_DATE_EPOCH=0

# --- Agent harness prerequisites (driftflow/harness.py, ISSUE-103) ---
# Harbor's TerminusV2 agent opens a tmux session in this container, records it, and drives
# the solver through it. Without tmux every rollout dies at agent setup with "Failed to start
# tmux session" before the agent takes a turn, and the whole cohort is lost. Nothing else in
# the local gates notices, because none of them starts the real agent.
#
# This layer needs build-time network for the package manager. Build with network enabled;
# that is independent of the task's run-time isolation, which task.toml still declares as
# no-network. Keep the base image digest-pinned.
#
# The build packages are the ones the colleague original's image installed. Debian ships *.patch files
# under /usr/share/doc, which isolation probes that walk the filesystem for private assets will flag.
# Drop the docs here rather than loosening a probe.
RUN if command -v apt-get >/dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends \
            asciinema build-essential ca-certificates curl gfortran git libfreetype6-dev libpng-dev \
            pkg-config tmux \
        && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man; \
    elif command -v apk >/dev/null; then \
        apk add --no-cache asciinema ca-certificates git tmux; \
    fi
# Fail the BUILD, not a paid cohort. Starting and tearing down a real session proves tmux
# works, which `command -v` does not.
RUN command -v git && command -v tmux \
    && tmux -V \
    && tmux -L harbor-build-smoke new-session -d -s smoke 'sleep 30' \
    && tmux -L harbor-build-smoke has-session -t smoke \
    && tmux -L harbor-build-smoke kill-server

# Keep the toolchain visible to login shells (`bash -lc`), not just `ENV`: /etc/profile rebuilds
# PATH and would otherwise discard the ENV entry.
RUN printf 'export VIRTUAL_ENV="/opt/venv"\nexport PATH="/opt/venv/bin:$PATH"\nexport PYTHONPATH="/workdir/src"\nexport PYTHONDONTWRITEBYTECODE="1"\nexport PYTHONHASHSEED="0"\nexport TZ="UTC"\n' \
      > /etc/profile.d/00-agentscope.sh && chmod 0644 /etc/profile.d/00-agentscope.sh

RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir 'pip==25.2' 'setuptools==75.8.2' 'wheel==0.45.1' 'uv==0.12.3'

# --- Solve-time dependencies: every package `agentscope[dev]` resolves to at the pinned commit (resolved with
# `uv pip compile --exclude-newer 2026-08-15`, hash-pinned). agentscope itself is not installed: it is imported
# from /workdir/src through PYTHONPATH. The requirements file is copied into a throwaway directory and removed.
COPY requirements.txt /opt/requirements/requirements.txt
RUN uv pip install --python /opt/venv/bin/python --no-deps --require-hashes --compile-bytecode \
        -r /opt/requirements/requirements.txt \
    && uv pip check --python /opt/venv/bin/python \
    && rm -rf /opt/requirements /root/.cache /tmp/* /var/tmp/*

RUN useradd -m -u 1000 -s /bin/bash agent 2>/dev/null || true \
    && git config --system --add safe.directory /workdir

# The solver starting state. Only this directory is copied into the image: the reusable baseline
# declaration and its documentation-curation patch stay in the build context.
COPY solver /workdir

WORKDIR /workdir
RUN find /workdir -depth \( -name __pycache__ -o -name '*.pyc' -o -name .pytest_cache \) -exec rm -rf -- {} + \
    && find /workdir -exec touch -h -d "2001-01-01T00:00:00Z" {} + 2>/dev/null || true
RUN chmod -R g-w,o-w /workdir
# A sanitized repository initialised from the solver starting state only: one commit, no remotes,
# no tags, no reflog, nothing that could expose the clean baseline or the answer.
RUN set -eu; \
    cd /workdir; \
    git init -q -b main --object-format=sha1; \
    git config core.logAllRefUpdates false; \
    git config core.pager cat; \
    git config gc.auto 0; \
    git add -A -f; \
    GIT_AUTHOR_NAME=task GIT_AUTHOR_EMAIL=task@example.invalid \
    GIT_COMMITTER_NAME=task GIT_COMMITTER_EMAIL=task@example.invalid \
    GIT_AUTHOR_DATE=2001-01-01T00:00:00Z GIT_COMMITTER_DATE=2001-01-01T00:00:00Z \
        git -c commit.gpgsign=false commit -qm "Initial state"; \
    test "$(git rev-list --all --count)" = 1; \
    test "$(git for-each-ref --format='%(refname)')" = refs/heads/main; \
    test -z "$(git remote)"; \
    test -z "$(git tag --list)"; \
    test -z "$(git stash list)"; \
    test -z "$(git reflog --all)"; \
    git diff --quiet; \
    git diff --cached --quiet; \
    test -z "$(git status --porcelain --untracked-files=all)"; \
    test -z "$(git fsck --strict --no-progress --no-reflogs --unreachable 2>&1)"; \
    git read-tree --reset HEAD; \
    chown -R agent:agent /workdir

# Smoke-check the solver's view: agentscope and every in-scope module import from /workdir/src, and no copy
# of agentscope is installed in site-packages.
RUN cd /tmp && /opt/venv/bin/python -W ignore -c "import importlib, pathlib; root = pathlib.Path('/workdir/src'); files = [p for d in ('agentscope/rag', 'agentscope/embedding', 'agentscope/credential', 'agentscope/message') for p in (root / d).rglob('*.py')]; names = sorted('.'.join(p.relative_to(root).with_suffix('').parts).removesuffix('.__init__') for p in files); mods = [importlib.import_module(n) for n in names]; assert all(m.__file__.startswith('/workdir/src/agentscope/') for m in mods), [m.__file__ for m in mods]; print(len(mods), 'in-scope modules import from /workdir/src')"

# --- Verifier dependencies -------------------------------------------------------------------
# The grader runs in its own image (tests/Dockerfile). Seal this interpreter as well: drop any .pth that
# would put /workdir on sys.path and keep the venv root-owned and unwritable by the agent.
RUN find /opt/venv -name '*.pth' -print0 | xargs -0 -r grep -l /workdir | xargs -r rm -f \
    && chown -R root:root /opt/venv \
    && chmod -R go-w /opt/venv \
    && /opt/venv/bin/python -c "import pydantic, qdrant_client, numpy, pytest; print('interpreter sealed')"
