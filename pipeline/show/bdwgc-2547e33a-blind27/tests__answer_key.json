  "weights": {
    "repair": 0.5,
    "report": 0.5
  },
  "run_tests_as": "agent",
  "baseline_tests": 20,
  "sabotage_passes": 0,
  "suite_seconds": 20,
  "probe_sites": 0,
  "probe_calls": 0,
