{
  "repo": "bdwgc",
  "workdir": "/workspace/repo",
  "target_test": "",
  "language": "c",
  "test_cmd": "cmake --build build -j 8 && ctest --test-dir build --output-junit /workspace/repo/results.xml --output-on-failure -j 4",
