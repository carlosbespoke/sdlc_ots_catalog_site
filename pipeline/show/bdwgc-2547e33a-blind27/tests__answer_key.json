    "cord/cordbscs.c": [
      "abort()"
    ],
    "cord/cordprnt.c": [
      "abort()"
    ],
    "cord/cordxtra.c": [
      "abort()"
    ],
    "include/private/gc_priv.h": [
      "#defineabort_act()abort()",
      "#definedebugbreak()_exit(-1)",
      "#defineabort_act()_exit(-1)",
      "#defineabort_act()abort()",
      "exit(1)",
      "if(syscall(__nr_access_hw_stacks,e2k_get_procedure_stack_size,null,",
      "if(syscall(__nr_access_hw_stacks,e2k_read_procedure_stack_ex,",
      "#definesetjmp(env)sigsetjmp(env,1)",
      "#definelongjmp(env,val)siglongjmp(env,val)",
      "#definesetjmp(env)setjmp(env)",
      "#definelongjmp(env,val)longjmp(env,val)"
    ],
    "mach_dep.c": [
      "(void)setjmp(regs)",
      "(void)_setjmp(regs)"
    ],
    "misc.c": [
      "atexit(gc_exit_check)",
      "result=syscall(sys_write,fd,buf+bytes_written,len-bytes_written)"
    ],
    "os_dep.c": [
      "intf=open(,o_rdonly)",
      "abort()",
      "abort_arg1(,",
      "abort()",
      "f=open(,o_rdonly)",
      "abort_arg1(,,errno)",
      "abort_arg1(,,errno)",
      "abort()",
      "warn(",
      "sigaction(sigsegv,&act,&old_segv_act)",
      "sigaction(sigsegv,&old_segv_act,null)",
      "(void)sigaction(sigsegv,null,&old_segv_act)",
      "(void)sigaction(sigsegv,&act,null)",
      "(void)sigaction(sigsegv,&act,&old_segv_act)",
      "(void)sigaction(sigbus,&act,&old_bus_act)",
      "old_segv_hand=signal(sigsegv,h)",
      "old_bus_hand=signal(sigbus,h)",
      "(void)sigaction(sigsegv,&old_segv_act,null)",
      "(void)sigaction(sigbus,&old_bus_act,null)",
      "(void)signal(sigsegv,old_segv_hand)",
      "(void)signal(sigbus,old_bus_hand)",
      "f=open(,o_rdonly)",
      "abort_arg1(,,errno)",
      "abort_arg1(,,errno)",
      "abort()",
      "sigaction(sigsegv,null,&oldact)",
      "sigaction(sigsegv,&act,null)",
      "intres=sigaction(sigsegv,&act,&oldact)",
      "sigaction(sigbus,&act,&oldact)",
      "if(syscall(sys_fcntl,gc_proc_fd,f_setfd,fd_cloexec)==-1)",
      "warn(,slash_filename)",
      "abort_arg1(,,",
      "abort_arg2(,",
      "abort_arg1(,,",
      "=syscall(sys_userfaultfd,o_cloexec|o_nonblock|uffd_user_mode_only)",
      "uffdwp_fd=syscall(sys_userfaultfd,o_cloexec|o_nonblock)",
      "if(sigaction(sigbus,&sa,&oldsa)<0)",
      "intret_code=readlink(,exe_name,exe_sz)"
    ],
    "pthread_stop_world.c": [
      "res=pthread_kill(thread_system_id(p),sig)",
      "if(sigaction(gc_sig_suspend,&act,null)!=0)",
      "if(sigaction(gc_sig_thr_restart,&act,null)!=0)"
    ],
    "pthread_support.c": [
      "pthread_exit(retval)"
    ],
    "tools/if_mach.c": [
      "execvp(trusted_string(argv[3]),(execv_argv_t)(argv+3))"
    ]
  },
