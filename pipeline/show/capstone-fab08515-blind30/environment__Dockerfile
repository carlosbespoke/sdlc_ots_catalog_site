RUN mkdir -p /workspace/repo && cd /workspace/repo \
    && git init -q && git remote add origin https://github.com/capstone-engine/capstone.git \
    && git fetch --depth 1 -q origin fab085153272a2e4f8d2c45ce3ce69f0cddf5246 \
