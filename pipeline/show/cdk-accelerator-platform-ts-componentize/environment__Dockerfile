# Agent image: the CDK app (TypeScript) in /workspace/accelerator-platform with the recorded production templates, an offline CDK
# toolchain and the repository's CI checks. No network at run time, no AWS credentials, and nothing from the verifier
# (no reference solution, no other environments' configurations, no grader).
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS node

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      asciinema bash ca-certificates curl git jq less procps python3 tmux unzip vim-tiny \
 && rm -rf /var/lib/apt/lists/*

# Shared CDK toolchain layer (TypeScript), identical in the agent image and the verifier image: Node.js from the pinned
# node image, the pinned CDK toolchain in /opt/cdk-node (npm ci from its lock file: aws-cdk CLI 2.1144.0,
# aws-cdk-lib 2.272.0, constructs 10.8.1, TypeScript 7.0.2, tsx, jest) and
# TypeScript 5.9.3 in /opt/lint-node for the code-rules checker.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY toolchain/ /opt/toolchain/
RUN set -eux; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
    for d in cdk-node lint-node; do \
      mkdir -p /opt/$d; cp /opt/toolchain/$d/package.json /opt/toolchain/$d/package-lock.json /opt/$d/; \
      (cd /opt/$d && npm ci --no-audit --no-fund --loglevel=error); \
    done; \
    npm cache clean --force; \
    ln -s /opt/cdk-node/node_modules/.bin/cdk /usr/local/bin/cdk; \
    chmod -R a+rX /opt/cdk-node /opt/lint-node /opt/toolchain; \
    node --version; cdk --version
ENV CDK_DISABLE_VERSION_CHECK=true \
    CDK_DISABLE_CLI_TELEMETRY=true \
    AWS_EC2_METADATA_DISABLED=true \
    JSII_SILENCE_WARNING_UNTESTED_NODE_VERSION=1

RUN groupadd --gid 1001 agent \
 && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash agent \
 && git config --system user.name "Accelerator Platform" \
 && git config --system user.email "platform@accelerator.example" \
 && git config --system init.defaultBranch main \
 && git config --system --add safe.directory /workspace/accelerator-platform

COPY --chown=agent:agent repo/ /workspace/accelerator-platform/

# The repository as the team has it: one commit, toolchain linked, CI green against the recorded templates.
RUN su agent -c 'set -e; cd /workspace/accelerator-platform; chmod +x scripts/ci.sh; \
      ln -s /opt/cdk-node/node_modules node_modules; \
      git init -q; git add -A; git commit -q -m "accelerator platform network delivery and operations stacks"; \
      bash scripts/ci.sh > /tmp/ci.log 2>&1 || { cat /tmp/ci.log; exit 1; }; rm -rf cdk.out /tmp/ci.log' \
 && tmux -V

# (No terraform plan or tmux server in a RUN step: build steps run under docker-default AppArmor, where a unix
# socket can panic this kernel, 7.0.0-1013-gcp; iacctl build already proved the clean plan.)
# No AWS access: SDK calls go to a dead loopback proxy so they fail at once instead of hanging on DNS and retries.
ENV HTTPS_PROXY=http://127.0.0.1:9 \
    HTTP_PROXY=http://127.0.0.1:9 \
    https_proxy=http://127.0.0.1:9 \
    http_proxy=http://127.0.0.1:9

WORKDIR /workspace/accelerator-platform
