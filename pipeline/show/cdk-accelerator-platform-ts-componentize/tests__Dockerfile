# Verifier image (separate verifier container): the same Node.js and pinned CDK toolchain as the agent image, Python 3,
# and the grader with its spec, the expected templates of every configuration (the deployed environments and the hidden
# ones), the configurations, the trusted copies of the files the agent must not change, and the grader's own CDK entry
# point. The agent's /workspace/accelerator-platform is copied in as an artifact before /tests/test.sh runs.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS node

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*

# Shared CDK toolchain layer (TypeScript), identical in the agent image and the verifier image: Node.js from the pinned
# node image, the pinned CDK toolchain in /opt/cdk-node (npm ci from its lock file: aws-cdk CLI 2.1144.0,
# aws-cdk-lib 2.272.0, constructs 10.8.1, TypeScript 7.0.2, tsx, jest) and
# TypeScript 5.9.3 in /opt/lint-node for the code-rules checker.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY toolchain/ /opt/toolchain/
RUN set -eux; \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
    for d in cdk-node lint-node; do \
      mkdir -p /opt/$d; cp /opt/toolchain/$d/package.json /opt/toolchain/$d/package-lock.json /opt/$d/; \
      (cd /opt/$d && npm ci --no-audit --no-fund --loglevel=error); \
    done; \
    npm cache clean --force; \
    ln -s /opt/cdk-node/node_modules/.bin/cdk /usr/local/bin/cdk; \
    chmod -R a+rX /opt/cdk-node /opt/lint-node /opt/toolchain; \
    node --version; cdk --version
ENV CDK_DISABLE_VERSION_CHECK=true \
    CDK_DISABLE_CLI_TELEMETRY=true \
    AWS_EC2_METADATA_DISABLED=true \
    JSII_SILENCE_WARNING_UNTESTED_NODE_VERSION=1

COPY . /tests/
RUN chmod 0700 /tests \
 && chmod 0755 /tests/test.sh \
 && mkdir -p /workspace /logs/verifier \
 && python3 -m py_compile /tests/grade.py /tests/cfn_equal.py /tests/iface.py \
 && python3 -c 'import json; json.load(open("/tests/spec.json")); json.load(open("/tests/hashes.json"))' \
 && NODE_PATH=/opt/lint-node/node_modules node -e 'require("/tests/rules.js")' \
 && rm -rf /tests/__pycache__ /tests/toolchain
