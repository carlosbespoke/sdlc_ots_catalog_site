# Agent image: the application repository at /workspace/ctfd and a private PostgreSQL 16.15 server holding the production
# snapshot. The snapshot is generated by the healthcheck (root, before the agent starts) from files the agent cannot
# read; `dbm reset` restores it at any time. No network at run time.
# Shared base of the agent and verifier images: pinned PostgreSQL 16 server binaries (the official image, its
# entrypoint disabled: no server starts at build time), Python 3.11 with the pinned migration toolchain (Alembic)
# and golang-migrate 4.20.1.
FROM postgres:16.15-bookworm@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates git jq less procps tmux vim-tiny \
      asciinema curl util-linux \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    curl -fsSLo /tmp/migrate.tgz "https://github.com/golang-migrate/migrate/releases/download/v4.20.1/migrate.linux-amd64.tar.gz"; \
    echo "b1e13121d4178b7804a9fb29dca62d57b732390f7e5ae33f2cd65e9b192e1bd4  /tmp/migrate.tgz" | sha256sum -c -; \
    tar -xzf /tmp/migrate.tgz -C /usr/local/bin migrate; rm -f /tmp/migrate.tgz; chmod 0755 /usr/local/bin/migrate; \
    /usr/local/bin/migrate -version
COPY requirements.lock /opt/dbm/requirements.lock
RUN python3 -m venv /opt/dbm/venv \
 && /opt/dbm/venv/bin/pip install --no-cache-dir --require-hashes -r /opt/dbm/requirements.lock \
 && rm -rf /root/.cache \
 && /opt/dbm/venv/bin/alembic --version && /opt/dbm/venv/bin/python -c "import psycopg, pglast, sqlalchemy"
ENTRYPOINT []
CMD ["sleep", "infinity"]
ENV PATH=/opt/dbm/venv/bin:/usr/lib/postgresql/16/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8

RUN groupadd --gid 1001 agent \
 && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash agent \
 && git config --system user.name "Lighthouse CTF Platform Team" \
 && git config --system user.email "platform@lighthouse-ctf.example" \
 && git config --system init.defaultBranch main \
 && git config --system --add safe.directory /workspace/ctfd

COPY dbsnap/ /opt/dbm/snapshot/
COPY dbmlib/ /opt/dbm/lib/
COPY dbm /usr/local/bin/dbm
COPY dbm.json /usr/local/share/dbm/dbm.json
RUN chmod -R go-rwx /opt/dbm/snapshot /opt/dbm/lib \
 && chmod 0755 /usr/local/bin/dbm && chmod 0644 /usr/local/share/dbm/dbm.json \
 && mkdir -p /var/lib/dbm && chmod 0755 /var/lib/dbm

COPY --chown=agent:agent repo/ /workspace/ctfd/

RUN su agent -c 'set -e; cd /workspace/ctfd; git init -q; git add -A; git commit -q -m "Database checkout at CTFd 3.x revision f63a9205d72f"'

ENV DATABASE_URL=postgresql+psycopg://ctfd:ctfd-app-7f3a9c@127.0.0.1:5432/ctfd \
    PGHOST=127.0.0.1 PGPORT=5432 PGUSER=ctfd PGPASSWORD=ctfd-app-7f3a9c PGDATABASE=ctfd
WORKDIR /workspace/ctfd
