    "sql": "SELECT (SELECT count(*) FROM users), count(*), md5(string_agg(concat_ws('|', user_id, website, affiliation, country_code), ',' ORDER BY user_id)) FROM user_profiles"
   },
   {
    "name": "countries",
    "sql": "SELECT count(*), md5(string_agg(code || '=' || name, ',' ORDER BY code)) FROM countries"
   },
   {
    "name": "prerequisites",
    "sql": "SELECT count(*), md5(string_agg(challenge_id || '>' || prerequisite_id, ',' ORDER BY challenge_id, prerequisite_id)) FROM challenge_prerequisites"
   },
   {
    "name": "anonymize",
    "sql": "SELECT coalesce(array_agg(id ORDER BY id), '{}') FROM challenges WHERE anonymize_locked"
   },
   {
    "name": "flags",
    "sql": "SELECT count(*), md5(string_agg(id || '|' || case_insensitive, ',' ORDER BY id)) FROM flags"
   },
   {
    "name": "unlocks",
    "sql": "SELECT count(*), md5(string_agg(concat_ws('|', id, type, hint_id, solution_id), ',' ORDER BY id)) FROM unlocks"
   },
   {
    "name": "activity",
    "sql": "SELECT count(*), max(id), md5(string_agg(concat_ws('|', id, type, ip, user_id, date, target), ',' ORDER BY id)) FROM user_activity"
   }
  ],
  "downgrade": [
   {
    "name": "submissions_legacy",
    "sql": "SELECT count(*), md5(string_agg(concat_ws('|', id, type, date, ip), ',' ORDER BY id)) FROM submissions"
   },
   {
    "name": "users_legacy",
    "sql": "SELECT count(*), md5(string_agg(concat_ws('|', id, email, website, affiliation, country), ',' ORDER BY id)) FROM users"
   },
   {
    "name": "requirements_legacy",
    "sql": "SELECT md5(string_agg(id || ':' || coalesce(requirements::jsonb::text, '~'), ',' ORDER BY id)) FROM challenges"
   },
   {
    "name": "flags_legacy",
