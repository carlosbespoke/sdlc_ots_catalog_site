USER agent
# The solver's starting state: the curated tree with the drift applied.
COPY --chown=agent:agent solver /workdir

# --- spec-drift-ots Phase B: seal the toolchain and the solver's starting state ---------------
USER root
RUN for home in /root /home/*; do for cache in .npm .cache .local/share/pnpm .pnpm-store .yarn .yarnrc .node_repl_history .turbo .nx .vite .vitest .parcel-cache .swc _cacache .yarn-cache .jest-cache .angular .svelte-kit .next .nuxt; do rm -rf "$home/$cache"; done; done; rm -rf /usr/local/share/.cache
RUN set -eu; PY="$(command -v python || command -v python3)"; \
    for p in $("$PY" -c 'import sys, sysconfig; g = sysconfig.get_paths(); print(" ".join(sorted({sys.prefix if sys.prefix != sys.base_prefix else g["stdlib"], g["stdlib"], g["platstdlib"], g["purelib"], g["platlib"]})))'); do \
