# spec-drift-ots TypeScript task image for TanStack/form@2216fdedf0a5ff17e4ef8567e1321442639b96ca, derived from the pool
# Dockerfile. /workdir is environment/solver/: the curated tree with the drift applied.
FROM --platform=linux/amd64 node@sha256:3d27e5c11e5786e309ec3e03f93ae536eb36e6e5eb3714d5eb3300a36157add0
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC CI=1 HUSKY=0 \
    NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false \
    COREPACK_ENABLE_NETWORK=0 COREPACK_ENABLE_STRICT=0 COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PATH=/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Keep the dependencies' binaries visible to login shells (`bash -lc`): /etc/profile rebuilds PATH.
RUN printf 'export PATH="/node_modules/.bin:$PATH"\n' > /etc/profile.d/00-spec-drift.sh && chmod 0644 /etc/profile.d/00-spec-drift.sh
# The official image's `node` user holds uid 1000, which the solver user takes.
RUN userdel -r node && useradd -m -u 1000 -s /bin/bash agent \
    && git config --system --add safe.directory /workdir
# The package manager the repository pins, installed root-owned (corepack would need network).
RUN npm install -g --cache /tmp/npm-cache --no-audit --no-fund pnpm@12.5.1 \
    && rm -rf /tmp/npm-cache /root/.npm /root/.cache
# --- Agent harness prerequisites (driftflow/harness.py, ISSUE-103) ---
# Harbor's TerminusV2 agent opens a tmux session in this container, records it, and drives
# the solver through it. Without tmux every rollout dies at agent setup with "Failed to start
# tmux session" before the agent takes a turn, and the whole cohort is lost. Nothing else in
# the local gates notices, because none of them starts the real agent.
#
# This layer needs build-time network for the package manager. Build with network enabled;
# that is independent of the task's run-time isolation, which task.toml still declares as
# no-network. Keep the base image digest-pinned.
#
# Debian ships *.patch files under /usr/share/doc, which isolation probes that walk the
# filesystem for private assets will flag. Drop the docs here rather than loosening a probe.
RUN if command -v apt-get >/dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends \
            asciinema ca-certificates git tmux \
        && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man; \
    elif command -v apk >/dev/null; then \
        apk add --no-cache asciinema ca-certificates git tmux; \
    fi
# Fail the BUILD, not a paid cohort. Starting and tearing down a real session proves tmux
# works, which `command -v` does not.
RUN command -v git && command -v tmux \
    && tmux -V \
    && tmux -L harbor-build-smoke new-session -d -s smoke 'sleep 30' \
    && tmux -L harbor-build-smoke has-session -t smoke \
    && tmux -L harbor-build-smoke kill-server
# The install inputs only (INSTALL_INPUTS: identical in every round, so the install layer is reused).
COPY deps /workdir
WORKDIR /workdir
