    && cd /tmp/spec-drift-stage \
    && pnpm install --frozen-lockfile --config.node-linker=hoisted --config.strict-dep-builds=false --config.confirm-modules-purge=false --store-dir /tmp/pnpm-store --reporter=append-only \
    && (test ! -d /tmp/spec-drift-stage/node_modules || find /tmp/spec-drift-stage/node_modules -path '*/.bin/*' -xtype l -delete) \
    && mkdir -p /tmp/spec-drift-stage/node_modules \
    && node -e 'const fs = require("fs"), path = require("path"); const [stage, repo, top, nested] = process.argv.slice(1); const moved = []; function walk(dir, out) { for (const e of fs.readdirSync(dir, {withFileTypes: true})) { const p = path.join(dir, e.name); if (e.isSymbolicLink()) out.push(p); else if (e.isDirectory()) walk(p, out); } return out; } const nestedDirs = []; (function find(dir) { for (const e of fs.readdirSync(dir, {withFileTypes: true})) { if (!e.isDirectory() || e.isSymbolicLink()) continue; const p = path.join(dir, e.name); if (e.name === "node_modules") { if (p !== path.join(stage, "node_modules") && !fs.existsSync(path.join(repo, path.relative(stage, p)))) nestedDirs.push(p); } else if (e.name !== ".git") find(p); } })(stage); moved.push([path.join(stage, "node_modules"), top]); fs.renameSync(path.join(stage, "node_modules"), top); for (const d of nestedDirs) { const rel = path.relative(stage, d), dest = path.join(nested, rel); fs.mkdirSync(path.dirname(dest), {recursive: true}); fs.renameSync(d, dest); moved.push([d, dest]); } moved.sort((a, b) => b[0].length - a[0].length); const place = (abs) => { for (const [from, to] of moved) if (abs === from || abs.startsWith(from + "/")) return to + abs.slice(from.length); if (abs === stage || abs.startsWith(stage + "/")) return repo + abs.slice(stage.length); return abs; }; const original = (p) => { for (const [from, to] of moved) if (p === to || p.startsWith(to + "/")) return from + p.slice(to.length); return p; }; let relinked = 0; for (const link of [...walk(top, []), ...(fs.existsSync(nested) ? walk(nested, []) : [])]) { const target = fs.readlinkSync(link); const was = path.resolve(path.dirname(original(link)), target); const now = place(was); if (path.resolve(path.dirname(link), target) !== now) { fs.unlinkSync(link); fs.symlinkSync(now, link); relinked++; } } /* A project the lock lists but the tree lacks (examples/.experimental in trpc: Horizon never uploads a hidden folder, so the tree of th