LABEL org.opencontainers.image.source="https://github.com/TanStack/form" \
      org.opencontainers.image.revision="2216fdedf0a5ff17e4ef8567e1321442639b96ca" \
      io.voyager.repo="TanStack/form" \
      io.voyager.language="typescript" \
      io.voyager.toolchain="node24" \
