    done; \
    rm -rf /root/.cache /home/agent/.cache /tmp/* /var/tmp/*
RUN find /workdir -depth \( -name __pycache__ -o -name '*.pyc' -o -name .pytest_cache \) -exec rm -rf -- {} + \
    && rm -rf /workdir/.git \
    && find /workdir -exec touch -h -d "2001-01-01T00:00:00Z" {} + \
    && chmod -R g-w,o-w /workdir
# A sanitized repository initialised from the solver starting state only: one commit, no remotes,
# no tags, no reflog, nothing that could expose the curated baseline or the answer.
RUN set -eu; \
    cd /workdir; \
    git init -q -b main --object-format=sha1; \
    git config core.logAllRefUpdates false; \
    git config core.pager cat; \
    git config gc.auto 0; \
    printf 'node_modules\n' >> .git/info/exclude; \
    git add -A -f -- . ':(exclude,glob)**/node_modules' ':(exclude,glob)**/node_modules/**'; \
    GIT_AUTHOR_NAME=task GIT_AUTHOR_EMAIL=task@example.invalid \
    GIT_COMMITTER_NAME=task GIT_COMMITTER_EMAIL=task@example.invalid \
    GIT_AUTHOR_DATE=2001-01-01T00:00:00Z GIT_COMMITTER_DATE=2001-01-01T00:00:00Z \
        git -c commit.gpgsign=false commit -qm "Initial state"; \
    test "$(git rev-list --all --count)" = 1; \
    test "$(git for-each-ref --format='%(refname)')" = refs/heads/main; \
    test -z "$(git remote)"; \
    test -z "$(git tag --list)"; \
    test -z "$(git stash list)"; \
    test -z "$(git reflog --all)"; \
    git diff --quiet; \
    git diff --cached --quiet; \
    test -z "$(git status --porcelain --untracked-files=all)"; \
    test -z "$(git fsck --strict --no-progress --no-reflogs --unreachable 2>&1)"; \
    git read-tree --reset HEAD; \
    chown -R agent:agent /workdir
USER agent
WORKDIR /workdir
CMD ["bash", "-lc", "sleep infinity"]
