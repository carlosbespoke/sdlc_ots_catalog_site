USER root

# harbor's terminus_2 rollout agent starts a tmux session INSIDE this image, and since
# 2026-08-31 the eval fleet no longer provides the binary itself — an image without
# tmux fails every rollout at setup ("Failed to start tmux session", 15/15 measured).
# Before {copies} so the apt layer caches across tasks sharing a pool image; apt's
# file timestamps land outside /workspace/repo, so the flattening below is unaffected.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/*
# The grader is Python whatever the repository is, and single-container means there is
# no verifier image to put it in: a pool image that ships none (a Go image is Debian with
# the toolchain) gets the base image's python3 here, root-owned under /usr/bin, which is
# the interpreter test.sh resolves on its trusted PATH. Before {copies} for the same
# caching reason as tmux.
# THE PROBE ASKS THE TRUSTED PATH, NOT THIS BUILD'S PATH. The pool image sets
# `ENV PATH=/opt/venv/bin:$PATH` and chowns /opt/venv to the agent, so a bare
# `command -v python3` answers with the AGENT'S interpreter and skips the install - while
# test.sh runs with PATH=/usr/local/bin:/usr/bin:/bin precisely to keep that venv off the
# search path, and would then find no python3 at all and grade nothing. Ask the same three
# directories test.sh will, and re-assert after the install so an image that still has no
# python3 on that path fails the BUILD rather than every rollout's grading.
RUN set -eu; \
    if ! PATH=/usr/local/bin:/usr/bin:/bin command -v python3 >/dev/null 2>&1; then \
        apt-get update -qq \
        && apt-get install -y -qq --no-install-recommends python3 \
        && rm -rf /var/lib/apt/lists/*; \
    fi; \
    PATH=/usr/local/bin:/usr/bin:/bin command -v python3 >/dev/null
COPY faults/fault0_executor.go /workspace/repo/executor.go
COPY faults/fault1_job.go /workspace/repo/job.go
COPY faults/fault2_logger.go /workspace/repo/logger.go
COPY faults/fault3_scheduler.go /workspace/repo/scheduler.go
COPY faults/fault4_util.go /workspace/repo/util.go

# The suite is removed here and restored at grade time by tests/grade.py, so the agent
# has nothing to run and the grader still grades on it.
RUN rm -rf /workspace/repo/example_test.go /workspace/repo/job_test.go /workspace/repo/logger_test.go /workspace/repo/scheduler_monitor_test.go /workspace/repo/scheduler_test.go /workspace/repo/util_test.go


# Every injected file carries the time it was copied in, and every other file carries the
# time the pool image was built. One find sorted by modification time therefore names the
# edited files and nothing else, which is the entire search. Flatten them all.
# The same applies to the file mode, and this one has to be ASSIGNED rather than
# subtracted. COPY brings the build context's permissions with it, and the pool image's
# own files are 0644, so an injected file arrives with whatever the build box's umask gave
# it. `chmod g-w,o-w` was enough while that was 0664 — the usual umask 002 — because the
# only difference was a bit to take away. falconry/falcon on the 2026-09-11 pool fleet ran
# on a box with umask 077: the files arrived 0600, subtracting write bits cannot put a
# read bit back, and `gate_standout` refused the build with "on disk, file mode separates
# the faulted files from every other .py file in the tree: they carry [384]", which is
# 0600. Dropping faults and rebuilding could not have helped — every injected file arrives
# 0600 whichever faults are cut — so the mode is set outright: 0755 for directories and
# for files that are already executable, 0644 for every other file. The tree then flattens
# to the same modes whatever the box's umask was, and the execute bits scripts need
# survive. The g-w,o-w sweep stays as a backstop for anything neither find matched.
# And so does the owner. COPY writes as root while the pool image left the tree to agent,
# so the six arrive root owned. Nothing on disk shows it, because the chown below puts the
# whole tree back to agent, but `git add` runs before that chown and caches the owner it
# saw: `git ls-files --debug` then reports uid 0 for the injected files and uid 1000 for
# every other one. Chown here, before the snapshot, so the index has nothing to tell.
RUN find /workspace/repo -exec touch -h -d "2001-01-01T00:00:00Z" {} + 2>/dev/null || true;     find /workspace/repo -type d -exec chmod 0755 {} + 2>/dev/null || true;     find /workspace/repo -type f -perm -u+x -exec chmod 0755 {} + 2>/dev/null || true;     find /workspace/repo -type f ! -perm -u+x -exec chmod 0644 {} + 2>/dev/null || true;     chmod -R g-w,o-w /workspace/repo 2>/dev/null || true;     chown -R agent:agent /workspace/repo 2>/dev/null || true

RUN set -eux; \
    rm -rf /workspace/repo/.git; \
    git init -q /workspace/repo; \
    git -C /workspace/repo config user.name "task"; \
    git -C /workspace/repo config user.email "task@example.invalid"; \
    git -C /workspace/repo config core.pager cat; \
    git config --global --add safe.directory /workspace/repo; \
    git -C /workspace/repo add -A; \
    git -C /workspace/repo commit -q -m "state at task start"; \
    test "$(git -C /workspace/repo rev-list --count HEAD)" = "1"

RUN mkdir -p /app && chown -R agent:agent /workspace/repo /app 2>/dev/null || true

# git otherwise opens a pager, which costs the agent turns escaping it.
ENV GIT_PAGER=cat
ENV PAGER=cat

WORKDIR /workspace/repo
USER agent
