USER root

# harbor's terminus_2 rollout agent starts a tmux session INSIDE this image, and since
# 2026-08-31 the eval fleet no longer provides the binary itself — an image without
# tmux fails every rollout at setup ("Failed to start tmux session", 15/15 measured).
# Before {copies} so the apt layer caches across tasks sharing a pool image; apt's
# file timestamps land outside /workspace/repo, so the flattening below is unaffected.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/*
# THE UNPRIVILEGED ACCOUNT, when the pool image did not make one. Every graded suite run
# drops to it (`setpriv --reuid agent` in the grader) and this image ends on USER agent,
# so an image without it cannot start a rollout at all, never mind grade one. Almost every
# pool Dockerfile creates it; the C sourcing generation does not -- `id agent` in both C
# pilot images answers "no such user" -- and this is cheaper than a pool regeneration and
# correct for every language. Conditional, so an image that already has the account keeps
# the uid and home directory the pool gave it. No fixed uid: ubuntu:24.04 already has a
# user at 1000, and failing the build over a taken uid would be a worse answer than a
# different number.
RUN id -u agent >/dev/null 2>&1 || useradd -m -s /bin/bash agent
# The grader is Python whatever the repository is, and tests/Dockerfile starts from this
# Dockerfile, so a pool image that ships none (a Go image is Debian with the toolchain)
# gets the base image's python3 here, root-owned under /usr/bin, which is the interpreter
# test.sh resolves on its trusted PATH. Here rather than in the verifier layers because
# the build's own gates run their scans with python3 inside the agent image too. Before
# {copies} for the same caching reason as tmux.
# THE PROBE ASKS THE TRUSTED PATH, NOT THIS BUILD'S PATH. The pool image sets
# `ENV PATH=/opt/venv/bin:$PATH` and chowns /opt/venv to the agent, so a bare
# `command -v python3` answers with the AGENT'S interpreter and skips the install - while
# test.sh runs with PATH=/usr/local/bin:/usr/bin:/bin precisely to keep that venv off the
# search path, and would then find no python3 at all and grade nothing. Ask the same three
# directories test.sh will, and re-assert after the install so an image that still has no
# python3 on that path fails the BUILD rather than every rollout's grading.
RUN set -eu; \
    if ! PATH=/usr/local/bin:/usr/bin:/bin command -v python3 >/dev/null 2>&1; then \
        apt-get update -qq \
        && apt-get install -y -qq --no-install-recommends python3 \
        && rm -rf /var/lib/apt/lists/*; \
    fi; \
    PATH=/usr/local/bin:/usr/bin:/bin command -v python3 >/dev/null
