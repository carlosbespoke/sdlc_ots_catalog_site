FROM --platform=linux/amd64 ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 SOURCE_DATE_EPOCH=0
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git config --system --add safe.directory '*'
RUN mkdir -p /workspace/repo && cd /workspace/repo \
    && git init -q && git remote add origin https://github.com/libexpat/libexpat.git \
    && git fetch --depth 1 -q origin 57c7da69b78e3698e112a6b5da19d5109b8232d1 \
    && git checkout -q FETCH_HEAD
WORKDIR /workspace/repo
RUN cmake -S expat -B build -DCMAKE_BUILD_TYPE=Release -DEXPAT_BUILD_TESTS=ON -DEXPAT_BUILD_FUZZERS=OFF -DEXPAT_SHARED_LIBS=ON
RUN cmake --build build -j 4
LABEL repo="libexpat/libexpat" revision="57c7da69b78e3698e112a6b5da19d5109b8232d1" language="c"

# ==========================================================================
# Task layers. Everything above is the upstream checkout at the buggy commit.
# ==========================================================================
USER root

# harbor's terminus_2 rollout agent starts a tmux session INSIDE this image, and since
# 2026-08-31 the eval fleet no longer provides the binary itself — an image without
# tmux fails every rollout at setup ("Failed to start tmux session", 15/15 measured).
# Before {copies} so the apt layer caches across tasks sharing a pool image; apt's
# file timestamps land outside /workspace/repo, so the flattening below is unaffected.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/*
# THE UNPRIVILEGED ACCOUNT, when the pool image did not make one. Every graded suite run
# drops to it (`setpriv --reuid agent` in the grader) and this image ends on USER agent,
# so an image without it cannot start a rollout at all, never mind grade one. Almost every
# pool Dockerfile creates it; the C sourcing generation does not -- `id agent` in both C
# pilot images answers "no such user" -- and this is cheaper than a pool regeneration and
# correct for every language. Conditional, so an image that already has the account keeps
# the uid and home directory the pool gave it. No fixed uid: ubuntu:24.04 already has a
# user at 1000, and failing the build over a taken uid would be a worse answer than a
# different number.
RUN id -u agent >/dev/null 2>&1 || useradd -m -s /bin/bash agent
# The grader is Python whatever the repository is, and tests/Dockerfile starts from this
# Dockerfile, so a pool image that ships none (a Go image is Debian with the toolchain)
# gets the base image's python3 here, root-owned under /usr/bin, which is the interpreter
# test.sh resolves on its trusted PATH. Here rather than in the verifier layers because
# the build's own gates run their scans with python3 inside the agent image too. Before
# {copies} for the same caching reason as tmux.
# THE PROBE ASKS THE TRUSTED PATH, NOT THIS BUILD'S PATH. The pool image sets
# `ENV PATH=/opt/venv/bin:$PATH` and chowns /opt/venv to the agent, so a bare
# `command -v python3` answers with the AGENT'S interpreter and skips the install - while
# test.sh runs with PATH=/usr/local/bin:/usr/bin:/bin precisely to keep that venv off the
# search path, and would then find no python3 at all and grade nothing. Ask the same three
# directories test.sh will, and re-assert after the install so an image that still has no
# python3 on that path fails the BUILD rather than every rollout's grading.
RUN set -eu; \
    if ! PATH=/usr/local/bin:/usr/bin:/bin command -v python3 >/dev/null 2>&1; then \
        apt-get update -qq \
        && apt-get install -y -qq --no-install-recommends python3 \
        && rm -rf /var/lib/apt/lists/*; \
    fi; \
    PATH=/usr/local/bin:/usr/bin:/bin command -v python3 >/dev/null


# The C test suite is hidden by stubbing its sources and taking the test
# executables out of the default build, rather than removing the suite, so the
# agent's own `cmake --build build` still builds the library. The grader restores
# the real sources and removes the marker, so the verifier builds and grades it.
RUN set -eu; \
    cd /workspace/repo; \
    printf '/* hidden: graded separately */\n' > expat/tests/benchmark/benchmark.c; \
    printf '/* hidden: graded separately */\n' > expat/tests/chardata.c; \
    printf '/* hidden: graded separately */\n' > expat/tests/chardata.h; \
    printf '/* hidden: graded separately */\n' > expat/tests/memcheck.c; \
    printf '/* hidden: graded separately */\n' > expat/tests/memcheck.h; \
    printf '/* hidden: graded separately */\n' > expat/tests/minicheck.c; \
    printf '/* hidden: graded separately */\n' > expat/tests/minicheck.h; \
    printf '/* hidden: graded separately */\n' > expat/tests/runtests.c; \
    printf '/* hidden: graded separately */\n' > expat/tests/runtestspp.cpp; \
    printf '/* hidden: graded separately */\n' > expat/tests/structdata.c; \
    printf '/* hidden: graded separately */\n' > expat/tests/structdata.h; \
    find /workspace/repo/expat/tests -type f ! -name 'CMakeLists.txt' ! -name '*.cmake' ! -name '*.c' ! -name '*.h' ! -name '*.cc' ! -name '*.cpp' ! -name '*.cxx' ! -name '*.hpp' ! -name '*.hh' -delete 2>/dev/null || true; \
    find /workspace/repo/testdata -type f ! -name 'CMakeLists.txt' ! -name '*.cmake' ! -name '*.c' ! -name '*.h' ! -name '*.cc' ! -name '*.cpp' ! -name '*.cxx' ! -name '*.hpp' ! -name '*.hh' -delete 2>/dev/null || true; \
    cmake --build build --target clean >/dev/null 2>&1 || true; \
    mkdir -p /opt; \
    printf '%b' '# Written by build_task.py. Hides the repository'"'"'s test executables from the agent'"'"'s\n# default build so `cmake --build build` works with the test sources stubbed. The grader\n# removes the marker once it restores the real suite, so the verifier builds the tests.\nif(EXISTS "${CMAKE_BINARY_DIR}/.hide_tests.on")\n  set(_HIDE_TESTS runtests;runtestspp)\n  function(_hide_test_targets)\n    foreach(_t IN LISTS _HIDE_TESTS)\n      if(TARGET ${_t})\n        set_target_properties(${_t} PROPERTIES EXCLUDE_FROM_ALL TRUE)\n      endif()\n    endforeach()\n  endfunction()\n  cmake_language(DEFER CALL _hide_test_targets)\nendif()\n' > /opt/hide_tests.overlay.cmake
RUN set -eu; \
    cd /workspace/repo; \
    touch build/.hide_tests.on; \
    cmake -S /workspace/repo/expat -B build -DCMAKE_PROJECT_INCLUDE=/opt/hide_tests.overlay.cmake >/dev/null; \
    cmake --build build -j "$(nproc)" >/dev/null


# ==========================================================================
# C: nothing compiled from the pristine tree may survive into this image.
# ==========================================================================
# The pool image built build from the checkout as it came from upstream, and the
# faults were injected after that, so every object and every test binary in there was
# compiled from the code the agent is being asked to reconstruct: `objdump -d` on one of
# them gives the original function back. They also make the fault INVISIBLE, because the
# flattening below gives the faulted source the same modification time as its own object
# and every build system reads that as up to date. `--target clean` removes exactly what
# the build produced and leaves the configuration alone, so the grader can still build.
# The other spellings are for a generator CMake does not drive; the check below is what
# decides whether any of them worked.
#
# THE CHECK HERE IS NARROWER THAN GATE 9'S ON PURPOSE. This one looks for object files by
# extension: it is a cheap assertion that `clean` actually ran, it fails the docker build
# outright, and a build failure is not waivable. Gate 9 asks the real question - is there
# any ELF or ar archive left under the workdir, whatever it is called - and it is a gate,
# so a repository that legitimately ships a binary fixture can be waived past it by a
# person with `--allow go-cache-leak`. Making this one as strict as the gate would move
# that judgement into a Dockerfile, where nobody can overrule it.
RUN set -eu; \
    cd /workspace/repo; \
    cmake --build build --target clean >/dev/null 2>&1 \
        || ninja -C build -t clean >/dev/null 2>&1 \
        || make -C build clean >/dev/null 2>&1 \
        || true; \
    rm -rf /root/.ccache /home/agent/.ccache "${CCACHE_DIR:-/nonexistent-ccache}"; \
    left="$(find /workspace/repo -type f \( -name '*.o' -o -name '*.a' -o -name '*.lo' \
                 -o -name '*.obj' -o -name '*.gch' \) 2>/dev/null | head -n 1)"; \
    if [ -n "$left" ]; then \
        echo "the build tree still holds $left after the purge, so the image carries \
code compiled from the tree before the faults" >&2; \
        exit 1; \
    fi

# Every injected file carries the time it was copied in, and every other file carries the
# time the pool image was built. One find sorted by modification time therefore names the
# edited files and nothing else, which is the entire search. Flatten them all.
# The same applies to the file mode, and this one has to be ASSIGNED rather than
# subtracted. COPY brings the build context's permissions with it, and the pool image's
# own files are 0644, so an injected file arrives with whatever the build box's umask gave
# it. `chmod g-w,o-w` was enough while that was 0664 — the usual umask 002 — because the
# only difference was a bit to take away. falconry/falcon on the 2026-09-11 pool fleet ran
# on a box with umask 077: the files arrived 0600, subtracting write bits cannot put a
# read bit back, and `gate_standout` refused the build with "on disk, file mode separates
# the faulted files from every other .py file in the tree: they carry [384]", which is
# 0600. Dropping faults and rebuilding could not have helped — every injected file arrives
# 0600 whichever faults are cut — so the mode is set outright: 0755 for directories and
# for files that are already executable, 0644 for every other file. The tree then flattens
# to the same modes whatever the box's umask was, and the execute bits scripts need
# survive. The g-w,o-w sweep stays as a backstop for anything neither find matched.
# And so does the owner. COPY writes as root while the pool image left the tree to agent,
# so the six arrive root owned. Nothing on disk shows it, because the chown below puts the
# whole tree back to agent, but `git add` runs before that chown and caches the owner it
# saw: `git ls-files --debug` then reports uid 0 for the injected files and uid 1000 for
# every other one. Chown here, before the snapshot, so the index has nothing to tell.
RUN find /workspace/repo -exec touch -h -d "2001-01-01T00:00:00Z" {} + 2>/dev/null || true;     find /workspace/repo -type d -exec chmod 0755 {} + 2>/dev/null || true;     find /workspace/repo -type f -perm -u+x -exec chmod 0755 {} + 2>/dev/null || true;     find /workspace/repo -type f ! -perm -u+x -exec chmod 0644 {} + 2>/dev/null || true;     chmod -R g-w,o-w /workspace/repo 2>/dev/null || true;     chown -R agent:agent /workspace/repo 2>/dev/null || true

RUN set -eux; \
    rm -rf /workspace/repo/.git; \
    git init -q /workspace/repo; \
    git -C /workspace/repo config user.name "task"; \
    git -C /workspace/repo config user.email "task@example.invalid"; \
    git -C /workspace/repo config core.pager cat; \
    git config --global --add safe.directory /workspace/repo; \
    git -C /workspace/repo add -A; \
    git -C /workspace/repo commit -q -m "state at task start"; \
    test "$(git -C /workspace/repo rev-list --count HEAD)" = "1"

RUN mkdir -p /app && chown -R agent:agent /workspace/repo /app 2>/dev/null || true

# git otherwise opens a pager, which costs the agent turns escaping it.
ENV GIT_PAGER=cat
ENV PAGER=cat

WORKDIR /workspace/repo
USER agent


# ==========================================================================
# Verifier-only layers. None of this exists in the agent image.
# ==========================================================================
USER root
COPY test.sh grade.py answer_key.json repo_tests.tgz /tests/
COPY hidden /tests/hidden
RUN chown -R root:root /tests \
 && chmod 700 /tests /tests/test.sh /tests/grade.py \
 && chmod 600 /tests/answer_key.json
