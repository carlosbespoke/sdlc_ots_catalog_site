ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 SOURCE_DATE_EPOCH=0

# Packages from the "regular" and "other-comp" Linux jobs in .github/workflows/ci.yml
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libtool \
        autoconf \
        automake \
        pkg-config \
        make \
        git \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN git config --system --add safe.directory '*'

RUN mkdir -p /workspace/repo \
    && cd /workspace/repo \
    && git init -q \
    && git remote add origin https://github.com/jedisct1/libsodium.git \
    && git fetch --depth 1 origin 57d44b954969b859ce8cf6aeeabb06ef28e65548 \
    && git checkout -q FETCH_HEAD \
    && git submodule update --init --recursive --depth 1

WORKDIR /workspace/repo

# ci.yml: "Autogen" step runs ./autogen.sh -s. -b keeps it from fetching config.guess
# and config.sub over the network; automake --add-missing installs them anyway.
RUN ./autogen.sh -s -b

# ci.yml: "other-comp" job, env CPPFLAGS="-DDEV_MODE=1" ./configure --disable-dependency-tracking
RUN env CPPFLAGS="-DDEV_MODE=1" ./configure --disable-dependency-tracking

RUN make -j"$(nproc)"

# Link the check programs at build time, so the offline test run only executes them.
RUN make -j"$(nproc)" check TESTS=

LABEL org.opencontainers.image.source="https://github.com/jedisct1/libsodium" \
      org.opencontainers.image.revision="57d44b954969b859ce8cf6aeeabb06ef28e65548" \
      io.srcpilot.language="c" \
      io.srcpilot.build_system="autotools" \
      io.srcpilot.test_framework="automake-tests" \
      io.srcpilot.results_format="tap"

