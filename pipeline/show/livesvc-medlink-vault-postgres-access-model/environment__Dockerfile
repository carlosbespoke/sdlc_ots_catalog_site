# Agent image. The platform services (postgres, vault) run as plain processes in this container: the healthcheck
# (platform-up) restores them from /opt/platform/snapshot and starts them before the agent starts; platform-reset puts
# them (and the local Terraform state) back to the snapshot at any time. Pinned toolchain, offline provider mirror, no
# network at run time; nothing from the verifier (no reference solution, no grader, no client credentials).
FROM postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip jq git python3 procps less tmux vim-tiny \
 && rm -rf /var/lib/apt/lists/*

ARG VAULT_VERSION=1.21.4
ARG VAULT_SHA256=889b681990fe221b884b7932fa9c9dd0ee9811b9349554f1aa287ab63c9f3dae
RUN set -eux; \
    curl -fsSLo /tmp/vault.zip "https://releases.hashicorp.com/vault/${VAULT_VERSION}/vault_${VAULT_VERSION}_linux_amd64.zip"; \
    echo "${VAULT_SHA256}  /tmp/vault.zip" | sha256sum -c -; \
    unzip -q /tmp/vault.zip -d /usr/local/bin vault; rm -f /tmp/vault.zip; vault version
ARG TERRAFORM_VERSION=1.16.4
ARG TERRAFORM_SHA256=dc94af0eef1147718ad7c8daea792ed199e3e0492eec180d0adafa2a65a879df
RUN set -eux; \
    curl -fsSLo /tmp/terraform.zip "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip"; \
    echo "${TERRAFORM_SHA256}  /tmp/terraform.zip" | sha256sum -c -; \
    unzip -q /tmp/terraform.zip -d /usr/local/bin terraform; rm -f /tmp/terraform.zip; \
    d=/opt/terraform/mirror/registry.terraform.io/hashicorp/vault/5.12.0/linux_amd64; mkdir -p $d; \
    curl -fsSLo /tmp/p.zip "https://releases.hashicorp.com/terraform-provider-vault/5.12.0/terraform-provider-vault_5.12.0_linux_amd64.zip"; \
    echo "c61fcc4d714cefee0696e2f8bf715b5826099e405f66acc859e496de688b6a8e  /tmp/p.zip" | sha256sum -c -; unzip -q /tmp/p.zip -d $d; rm -f /tmp/p.zip; \
    d=/opt/terraform/mirror/registry.terraform.io/cyrilgdn/postgresql/1.27.0/linux_amd64; mkdir -p $d; \
    curl -fsSLo /tmp/p.zip "https://github.com/cyrilgdn/terraform-provider-postgresql/releases/download/v1.27.0/terraform-provider-postgresql_1.27.0_linux_amd64.zip"; \
    echo "1c962ce9e73d96b368354607fd30dc55313c39f03f7ca5f3dea64e143b4f7c06  /tmp/p.zip" | sha256sum -c -; unzip -q /tmp/p.zip -d $d; rm -f /tmp/p.zip; \
    chmod -R a+rX /opt/terraform; terraform version
COPY terraformrc /etc/terraformrc
ENV TF_CLI_CONFIG_FILE=/etc/terraformrc CHECKPOINT_DISABLE=1

RUN groupadd --gid 1001 agent \
 && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash agent \
 && git config --system user.name "Medlink Platform Team" \
 && git config --system user.email "platform@medlink.example" \
 && git config --system init.defaultBranch main \
 && git config --system --add safe.directory /workspace/platform

COPY platform/ /opt/platform/
RUN install -m 0755 /opt/platform/platform-up /usr/local/bin/platform-up \
 && install -m 0755 /opt/platform/platform-reset /usr/local/bin/platform-reset \
 && mkdir -p /var/lib/platform /var/log/vault \
 && chown agent:agent /var/lib/platform /var/log/vault \
 && chmod -R a+rX /opt/platform \
 && python3 -m py_compile /opt/platform/platformctl.py && rm -rf /opt/platform/__pycache__

# The repository as the team has it (dotfiles travel without their dot: the task upload skips dotfiles).
COPY --chown=agent:agent repo/ /workspace/platform/
RUN su agent -c 'set -e; cd /workspace/platform; mv gitignore .gitignore; mv terraform.lock.hcl .terraform.lock.hcl; \
      git init -q; git add -A; git commit -q -m "platform repository at release 2026.09.2 (phase 0)"' \
 && install -o agent -g agent -m 0600 /opt/platform/snapshot/vault-root.token /home/agent/.vault-token

ENV PATH=/usr/lib/postgresql/17/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    VAULT_ADDR=http://127.0.0.1:8200 \
    PGHOST=127.0.0.1 \
    PGPORT=5432 \
    PGUSER=postgres \
    PGPASSWORD=Vrjo-N2IQM1v1M9Hd1R-OOXT \
    PGDATABASE=postgres
WORKDIR /workspace/platform
