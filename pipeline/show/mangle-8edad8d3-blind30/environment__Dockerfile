# ==========================================================================
# Go: nothing compiled from the pristine tree may survive into this image.
# ==========================================================================
# The pool image above warms the build cache with `go build ./...` on the checkout as it
# came from upstream, and the faults are injected after that, so every object in that
# cache describes the code the agent is being asked to reconstruct. GOCACHE sits outside
# /workspace/repo, where neither the flattening nor the git snapshot below reaches it, and the
# pool image hands it to uid 1000: `go tool objdump` on one of those objects gives the
# original function straight back. Empty the cache here, check that it really is empty,
# and re-warm it on the FAULTED tree so the agent still starts warm. The module cache is
# kept, because it holds third-party dependencies and never this repository's own code,
# and a rollout has no network to fetch them again.
#
# The first check is that GOCACHE is in the image ENVIRONMENT. This layer runs as root and
# the image ends on USER agent, so if GOCACHE came from HOME instead, root would purge and
# warm /root/.cache/go-build while uid 1000 read /home/agent/.cache/go-build, and the agent
# would start cold with a few hundred megabytes of unreachable cache in the image. All 699
# Go pool Dockerfiles in the store set it and the generator's own test pins it, so this
# cannot fire today; it is here so that a generator that stopped setting it fails the build
# loudly rather than making every Go task quietly slower. `go env` is compared against the
# variable as well, because `go env -w` writes into a config file under HOME, which root
# and the agent do not share either.
#
# The re-warm runs once per module rather than once per tree. `./...` reaches only the
# module it is run in, so a repository with a nested module, or a workspace whose root is
# not itself a module, would have had the purge empty its cache and the re-warm refill
# only part of it, or none of it. Modules are found the way gates.py finds them, by
# walking for go.mod outside vendor and testdata, and read one line at a time rather than
# word split, so a directory with a space in its name is one module and not two. The loop
# body runs in a subshell because of the pipe, which is why a module that will not build
# is carried out on a marker file and not on a variable.
#
# The re-warm is `go install` with GOBIN pointed at a temporary directory, which is the one
# spelling that is safe on every shape a Go module comes in. Measured on go1.23, for a
# module with a main package, a library it imports and a library nothing imports:
#
#   go build ./...            compiles all 391 cache entries, but writes its executable
#                             INTO THE TREE when ./... is a single main package
#   go build -o "$out" ./...  writes nothing to the tree, warms 386, and FAILS OUTRIGHT on
#                             a library-only module with "no main packages to build",
#                             which is most of the pool and would ship a cold cache
#   GOBIN="$out" go install   writes nothing to the tree on any shape, warms 385, and is
#                             happy with a module that has no main package at all
#
# A library-only module therefore leaves GOBIN empty, which is the healthy result and not
# a re-warm that did nothing. The 6 entries `go install` leaves for later are link actions
# for main packages, seconds of work against the 100 seconds a cold compile costs every
# rollout and every grading pass, and the grader never asks for them because every `go`
# invocation in it is `go test`. Nothing in the tree is written or deleted either way,
# which matters because a pool CAN legitimately build into the repository: metal3 builds
# two plugins there. Those are the pool's to produce and gate 9's to report, not this
# layer's to touch.
RUN set -eu; \
    cd /workspace/repo; \
    if [ -z "${GOCACHE:-}" ] || [ "$(go env GOCACHE)" != "$GOCACHE" ]; then \
        echo "GOCACHE is not set in the image environment, so this layer as root and \
the agent at run time would not share a build cache" >&2; \
        exit 1; \
    fi; \
    git config --global --add safe.directory /workspace/repo 2>/dev/null || true; \
    go clean -cache -testcache >/dev/null 2>&1 || true; \
    rm -rf "$GOCACHE" /root/.cache/go-build /home/agent/.cache/go-build; \
    left="$(find "$GOCACHE" /root/.cache/go-build \
                 /home/agent/.cache/go-build -type f 2>/dev/null | head -n 1)"; \
    if [ -n "$left" ]; then \
        echo "the Go build cache still holds $left after the purge" >&2; \
        exit 1; \
    fi; \
    out="$(mktemp -d)"; \
    mods="$(find . -name go.mod -type f ! -path './.git/*' ! -path '*/vendor/*' \
            ! -path '*/testdata/*' 2>/dev/null | sed 's|/go.mod$||' | sort)"; \
    test -n "$mods" || mods="."; \
    printf '%s\n' "$mods" | while IFS= read -r m; do \
        ( cd "$m" && GOBIN="$out" go install ./... ) >/dev/null 2>&1 \
            || : > "$out/.cold"; \
    done; \
    if [ -e "$out/.cold" ]; then \
        rm -rf "$GOCACHE"; \
        echo "the faulted tree does not build in full, so the cache stays cold" >&2; \
    fi; \
    rm -rf "$out"; \
    chown -R agent:agent "$GOCACHE" 2>/dev/null || true

# Every injected file carries the time it was copied in, and every other file carries the
# time the pool image was built. One find sorted by modification time therefore names the
# edited files and nothing else, which is the entire search. Flatten them all.
# The same applies to the file mode, and this one has to be ASSIGNED rather than
# subtracted. COPY brings the build context's permissions with it, and the pool image's
# own files are 0644, so an injected file arrives with whatever the build box's umask gave
# it. `chmod g-w,o-w` was enough while that was 0664 — the usual umask 002 — because the
# only difference was a bit to take away. falconry/falcon on the 2026-09-11 pool fleet ran
# on a box with umask 077: the files arrived 0600, subtracting write bits cannot put a
# read bit back, and `gate_standout` refused the build with "on disk, file mode separates
# the faulted files from every other .py file in the tree: they carry [384]", which is
# 0600. Dropping faults and rebuilding could not have helped — every injected file arrives
# 0600 whichever faults are cut — so the mode is set outright: 0755 for directories and
# for files that are already executable, 0644 for every other file. The tree then flattens
# to the same modes whatever the box's umask was, and the execute bits scripts need
# survive. The g-w,o-w sweep stays as a backstop for anything neither find matched.
# And so does the owner. COPY writes as root while the pool image left the tree to agent,
# so the six arrive root owned. Nothing on disk shows it, because the chown below puts the
# whole tree back to agent, but `git add` runs before that chown and caches the owner it
# saw: `git ls-files --debug` then reports uid 0 for the injected files and uid 1000 for
# every other one. Chown here, before the snapshot, so the index has nothing to tell.
RUN find /workspace/repo -exec touch -h -d "2001-01-01T00:00:00Z" {} + 2>/dev/null || true;     find /workspace/repo -type d -exec chmod 0755 {} + 2>/dev/null || true;     find /workspace/repo -type f -perm -u+x -exec chmod 0755 {} + 2>/dev/null || true;     find /workspace/repo -type f ! -perm -u+x -exec chmod 0644 {} + 2>/dev/null || true;     chmod -R g-w,o-w /workspace/repo 2>/dev/null || true;     chown -R agent:agent /workspace/repo 2>/dev/null || true

RUN set -eux; \
    rm -rf /workspace/repo/.git; \
    git init -q /workspace/repo; \
    git -C /workspace/repo config user.name "task"; \
    git -C /workspace/repo config user.email "task@example.invalid"; \
    git -C /workspace/repo config core.pager cat; \
    git config --global --add safe.directory /workspace/repo; \
    git -C /workspace/repo add -A; \
    git -C /workspace/repo commit -q -m "state at task start"; \
    test "$(git -C /workspace/repo rev-list --count HEAD)" = "1"

RUN mkdir -p /app && chown -R agent:agent /workspace/repo /app 2>/dev/null || true

