FROM golang:1.25-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git python3 ca-certificates tmux asciinema && rm -rf /var/lib/apt/lists/*
RUN ln -sf /usr/local/go/bin/go /usr/local/bin/go && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOFLAGS=-mod=mod GOTELEMETRY=off GOPATH=/go GOMODCACHE=/go/pkg/mod
COPY repo/ /app/
WORKDIR /app
RUN cd /app && GOPROXY=https://proxy.golang.org,direct go mod download all && (go build ./... || echo 'fb warm-up: go build ./... reported errors (above)') && for p in $(go list ./...); do go test -c -vet=off -o /dev/null "$p" || echo "fb warm-up: $p does not compile with this image's Go"; done
ENV GOPROXY=off
ENV GIT_AUTHOR_NAME=mig GIT_AUTHOR_EMAIL=mig@local GIT_COMMITTER_NAME=mig GIT_COMMITTER_EMAIL=mig@local GIT_AUTHOR_DATE=2020-01-01T00:00:00Z GIT_COMMITTER_DATE=2020-01-01T00:00:00Z
RUN cd /app && git init -q && git add -A && git -c commit.gpgsign=false commit -qm base && git tag mig-base
RUN rm -f /usr/local/bin/go && printf '#!/bin/sh\nulimit -Sv %s 2>/dev/null\nexec /usr/local/go/bin/go "$@"\n' 6291456 > /usr/local/bin/go && chmod 755 /usr/local/bin/go && cp /usr/local/bin/go /go/bin/go
CMD ["bash"]
