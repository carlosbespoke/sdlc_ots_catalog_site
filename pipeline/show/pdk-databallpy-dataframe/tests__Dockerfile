# The verifier's container: the same base and repository environment as environment/Dockerfile
# (keep the two in step), the grader's own root-owned interpreter, and the unprivileged user the
# submission runs as.
FROM mirror.gcr.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

ARG REPO_URL=https://github.com/Alek050/databallpy.git
ARG BASE_COMMIT=f21d47f9dded55b12da6e0ba16ebf48e10bad84b
ENV CI=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1

RUN set -eu; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
      bash build-essential ca-certificates curl file git jq less procps vim-tiny; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git init -q /app && git -C /app remote add origin "$REPO_URL" \
    && git -C /app fetch -q --depth 1 origin "$BASE_COMMIT" && git -C /app checkout -q --detach FETCH_HEAD \
    && test "$(git -C /app rev-parse HEAD)" = "$BASE_COMMIT" \
    && git -C /app remote remove origin && rm -f /app/.git/FETCH_HEAD
# The same dependency install as environment/Dockerfile (the repository's own lock).
RUN set -eu; python -m venv /opt/venv; \
    /opt/venv/bin/pip install -q \
      accessible-space==2.0.15 aiohappyeyeballs==2.6.1 aiohttp==3.13.5 aiosignal==1.4.0 \
      annotated-types==0.7.0 anyio==4.13.0 argon2-cffi==25.1.0 argon2-cffi-bindings==25.1.0 \
      arrow==1.4.0 asttokens==3.0.1 async-lru==2.3.0 attrs==26.1.0 babel==2.18.0 \
      beautifulsoup4==4.14.3 bleach==6.3.0 certifi==2026.2.25 cffi==2.0.0 chardet==5.2.0 \
      charset-normalizer==3.4.7 comm==0.2.3 contourpy==1.3.2 coverage==7.13.5 cycler==0.12.1 \
      debugpy==1.8.20 decorator==5.2.1 defusedxml==0.7.1 executing==2.2.1 fastjsonschema==2.21.2 \
      fonttools==4.62.1 fqdn==1.5.1 frozenlist==1.8.0 fsspec==2026.3.0 h11==0.16.0 httpcore==1.0.9 \
      httpx==0.28.1 idna==3.11 iniconfig==2.3.0 ipykernel==6.31.0 ipython==8.39.0 \
      ipython-genutils==0.2.0 ipywidgets==8.1.8 isoduration==20.11.0 jedi==0.19.2 jinja2==3.1.6 \
      joblib==1.5.3 json5==0.14.0 jsonpointer==3.1.1 jsonschema==4.26.0 \
      jsonschema-specifications==2025.9.1 jupyter==1.1.1 jupyter-client==8.8.0 \
      jupyter-console==6.6.3 jupyter-core==5.9.1 jupyter-events==0.12.0 jupyter-lsp==2.3.1 \
      jupyter-server==2.17.0 jupyter-server-terminals==0.5.4 jupyterlab==4.5.6 \
      jupyterlab-pygments==0.3.0 jupyterlab-server==2.28.0 jupyterlab-widgets==3.0.16 \
      kiwisolver==1.5.0 kloppy==3.18.0 lark==1.3.1 line-profiler==4.2.0 lxml==6.0.4 \
      markupsafe==3.0.3 matplotlib==3.10.8 matplotlib-inline==0.2.1 mistune==3.2.0 multidict==6.7.1 \
      mypy-extensions==1.1.0 nbclient==0.10.4 nbconvert==7.17.1 nbformat==5.10.4 \
      nest-asyncio==1.6.0 notebook==7.5.5 notebook-shim==0.2.4 numpy==2.2.6 packaging==26.0 \
      pandas==2.3.3 pandera==0.29.0 pandocfilters==1.5.1 parso==0.8.6 pexpect==4.9.0 pillow==12.2.0 \
      platformdirs==4.9.6 pluggy==1.6.0 prometheus-client==0.25.0 prompt-toolkit==3.0.52 \
      propcache==0.4.1 psutil==7.2.2 ptyprocess==0.7.0 pure-eval==0.2.3 pyarrow==22.0.0 \
      pycparser==3.0 pydantic==2.13.0 pydantic-core==2.46.0 pygments==2.20.0 pyparsing==3.3.2 \
      pytest==9.0.3 pytest-cov==4.1.0 python-dateutil==2.9.0.post0 python-json-logger==4.1.0 \
      pytz==2026.1.post1 pyyaml==6.0.3 pyzmq==27.1.0 referencing==0.37.0 requests==2.33.1 \
      rfc3339-validator==0.1.4 rfc3986-validator==0.1.1 rfc3987-syntax==1.1.0 rpds-py==0.30.0 \
      ruff==0.7.4 scikit-learn==1.7.2 scipy==1.17.1 send2trash==2.1.0 setuptools==82.0.1 \
      six==1.17.0 sortedcontainers==2.4.0 soupsieve==2.8.3 stack-data==0.6.3 terminado==0.18.1 \
      threadpoolctl==3.6.0 tinycss2==1.4.0 tornado==6.5.5 tqdm==4.67.3 traitlets==5.14.3 \
      typeguard==4.5.1 typing-extensions==4.15.0 typing-inspect==0.9.0 typing-inspection==0.4.2 \
      tzdata==2026.1 uri-template==1.3.0 urllib3==2.6.3 wcwidth==0.6.0 webcolors==25.10.0 \
      webencodings==0.5.1 websocket-client==1.9.0 widgetsnbextension==4.0.15 yarl==1.23.0; \
    /opt/venv/bin/pip install -q -e /app --no-deps; \
    chmod -R go-w /opt/venv

# The grader's interpreter: root-owned, outside the repository, never on the submission's path.
COPY grader-requirements.txt /opt/dp-grader-requirements.txt
RUN set -eu; python -m venv /opt/dp-grader-venv; \
    /opt/dp-grader-venv/bin/pip install -q -r /opt/dp-grader-requirements.txt; \
    chmod -R go-w /opt/dp-grader-venv

COPY grader.py /tests/grader.py
COPY config.json /tests/config.json
COPY test.patch /tests/test.patch
COPY test.sh /tests/test.sh
COPY extract_base_pytest.py /tests/extract_base_pytest.py
RUN chmod +x /tests/test.sh && useradd --create-home --uid 1500 dpapp

# Check the staged hidden suite compiles, then restore the tree. After stage the tree is the base
# commit again, so pin-base pins the repo suite's pytest config, rootdir and plugins (and the base
# ruff settings) from it.
RUN set -eu; \
    git -C /app apply --whitespace=nowarn /tests/test.patch; \
    GRADE_DIR=/tmp/warm bash /app/test.sh stage; \
    GRADE_DIR=/tmp/warm bash /tmp/warm/test.sh pin-base; \
    chmod 600 /opt/dp-base/base-pytest.* /tests/extract_base_pytest.py; \
    GRADE_DIR=/tmp/warm bash /tmp/warm/test.sh build-tests; \
    rm -rf /tmp/warm; \
    git -C /app checkout -q -- .; git -C /app clean -qfd -- tests; \
    test -z "$(git -C /app status --porcelain)"

CMD ["/bin/bash"]
