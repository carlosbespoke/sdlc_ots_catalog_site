# The solver's container: dbconform at the base commit, its locked dependencies in /opt/venv, and a copy
# of one production database with the models it should match in /data.
FROM mirror.gcr.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

ARG REPO_URL=https://github.com/brian-pond/dbconform.git
ARG BASE_COMMIT=8f3dc04161e4ffe07499b0ded25e0542f2edeb40
ENV CI=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1

# tmux and asciinema are required by Harbor's solver agent.
RUN set -eu; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
      tmux asciinema bash build-essential ca-certificates curl file git jq less procps sqlite3 vim-tiny; \
    rm -rf /var/lib/apt/lists/*

# The repository at the base commit only: one commit, no remote, no reflog.
WORKDIR /app
RUN git init -q /app && git -C /app remote add origin "$REPO_URL" \
    && git -C /app fetch -q --depth 1 origin "$BASE_COMMIT" && git -C /app checkout -q --detach FETCH_HEAD \
    && test "$(git -C /app rev-parse HEAD)" = "$BASE_COMMIT" \
    && git -C /app remote remove origin && rm -f /app/.git/FETCH_HEAD \
    && git -C /app reflog expire --expire=now --all && git -C /app gc -q --prune=now

# Every extra and group of the repository's uv.lock, installed outside /app; the package is editable.
RUN set -eu; pip install -q uv==0.12.23; \
    (cd /app && uv export --frozen --all-extras --all-groups --no-hashes --no-emit-project -o /tmp/requirements.txt); \
    python -m venv /opt/venv; \
    /opt/venv/bin/pip install -q -r /tmp/requirements.txt; \
    /opt/venv/bin/pip install -q -e /app --no-deps; \
    rm -f /tmp/requirements.txt; pip uninstall -q -y uv
ENV PATH=/opt/venv/bin:$PATH
# Login shells reset PATH in /etc/profile; put the repository's environment first there too.
RUN printf 'case ":$PATH:" in *:/opt/venv/bin:*) ;; *) PATH="/opt/venv/bin:$PATH" ;; esac\nexport PATH\n' \
      > /etc/profile.d/00-venv.sh

COPY data/ /data/

CMD ["/bin/bash"]
