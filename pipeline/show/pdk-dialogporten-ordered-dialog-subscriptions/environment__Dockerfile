# environment/Dockerfile for a C# task. The agent's container: the repository at the base commit,
# its services installed (single-container tasks) and every package restored, so it builds offline.
# FILL the values marked FILL. Pin the base image by digest.
FROM mcr.microsoft.com/dotnet/sdk:10.0.401@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317

# FILL: the repository and the base commit.
ARG REPO_URL=https://github.com/digdir/dialogporten.git
ARG BASE_COMMIT=1eb4fbbc91d0f9c8248160cbc0fc03306e83aa8e
ENV CI=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    NUGET_PACKAGES=/opt/nuget/packages \
    PATH=/opt/dotnet-tools:$PATH

# tmux and asciinema are required by Harbor's solver agent. FILL: the services the task needs
# (single-container tasks); drop them for compose tasks.
RUN set -eu; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      tmux asciinema bash sudo ca-certificates curl git jq less lsof netcat-openbsd procps python3 vim-tiny \
      redis-server postgresql-common gnupg; \
    install -d /etc/apt/keyrings; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg; \
    printf 'deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt noble-pgdg main\n' > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends postgresql-18 postgresql-client-18; \
    rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    service postgresql start; \
    su postgres -c "psql -v ON_ERROR_STOP=1 -c \"ALTER USER postgres PASSWORD 'postgres'\""; \
    service postgresql stop

# The solver runs as the unprivileged user "agent" (task.toml: [agent] user = "agent"). agent is
# created before the repository is fetched, and fetches, installs and builds it (USER agent below),
# so it owns every file without a chown pass: a `chown -R` in its own layer copies the whole tree
# (16 minutes and twice the image size on a large monorepo). It may start the image's services with
# sudo, since they need root: only /usr/local/sbin/service, which takes one installed service name
# and start, stop, restart or status (plain /usr/sbin/service runs a path such as ../../tmp/x as
# root). The image's default user is root again at the end; switch back to root (USER root) only for
# steps that need it, such as apt-get.
RUN set -eu; \
    useradd -m -s /bin/bash agent; \
    install -d -o agent -g agent /app /logs /logs/artifacts /opt/nuget /opt/dotnet-tools; \
    git config --system --add safe.directory /app; \
    printf '%s\n' '#!/bin/sh' \
      'case "$1" in ""|-*|.*|*/*) echo "usage: service <name> start|stop|restart|status" >&2; exit 2 ;; esac' \
      'case "$2" in start|stop|restart|status) ;; *) echo "usage: service <name> start|stop|restart|status" >&2; exit 2 ;; esac' \
      '[ "$#" -eq 2 ] && [ -x "/etc/init.d/$1" ] || { echo "no service $1" >&2; exit 2; }' \
      'exec /usr/sbin/service "$1" "$2"' > /usr/local/sbin/service; \
    chmod 755 /usr/local/sbin/service; \
    echo 'agent ALL=(root) NOPASSWD: /usr/local/sbin/service' > /etc/sudoers.d/agent-services; \
    chmod 440 /etc/sudoers.d/agent-services
USER agent

WORKDIR /app
# The repository at exactly the base commit, with no other history.
RUN git init -q /app && git -C /app remote add origin "$REPO_URL" \
    && git -C /app fetch -q --depth 1 origin "$BASE_COMMIT" && git -C /app checkout -q --detach FETCH_HEAD \
    && test "$(git -C /app rev-parse HEAD)" = "$BASE_COMMIT"

# The base GraphQL app maps the subscription endpoint but never enables WebSockets, so no client can
# open dialogEvents at all. app.UseWebSockets() is committed on top of it with a fixed identity and
# dates, so both images get the same base commit, FIXED_BASE_COMMIT, which grading diffs against.
ARG FIXED_BASE_COMMIT=18b3a4dee4af29ffe92103b0e263a9c7349131af
RUN sed -i 's/^    app\.UseCors();$/    app.UseWebSockets();\n    app.UseCors();/' /app/src/Digdir.Domain.Dialogporten.GraphQL/Program.cs \
    && GIT_AUTHOR_NAME=sd GIT_AUTHOR_EMAIL=sd@example.invalid GIT_COMMITTER_NAME=sd GIT_COMMITTER_EMAIL=sd@example.invalid \
       GIT_AUTHOR_DATE='2026-01-01T00:00:00Z' GIT_COMMITTER_DATE='2026-01-01T00:00:00Z' \
       git -C /app commit -q -am 'Enable WebSockets for GraphQL subscriptions' \
    && test "$(git -C /app rev-parse HEAD)" = "$FIXED_BASE_COMMIT"

RUN dotnet tool install --tool-path /opt/dotnet-tools dotnet-ef --version 10.0.11   # FILL: match the repo's EF Core, or drop

# Restore and build everything the agent and the grader build, so both work offline.
RUN set -eu; \
    for p in src/Digdir.Domain.Dialogporten.WebApi src/Digdir.Domain.Dialogporten.Service src/Digdir.Domain.Dialogporten.GraphQL tests/Digdir.Domain.Dialogporten.Application.Unit.Tests; do \
      dotnet build "$p" -c Debug -v q -nologo -p:NuGetAudit=false; \
    done; \
    chmod -R a+rX /opt/nuget                                         # FILL: the project list

USER root
CMD ["/bin/bash"]
