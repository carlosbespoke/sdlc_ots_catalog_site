# The verifier's container: the same base and repository environment as environment/Dockerfile,
# the grader's own root-owned interpreter, and the unprivileged user the submission runs as.
FROM mirror.gcr.io/library/python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641

ARG REPO_URL=https://github.com/Dagitali/ETLPlus.git
ARG BASE_COMMIT=36527c8c712fa3ba3b88882a497c70d5faaf1374
ENV CI=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 DO_NOT_TRACK=1

RUN set -eu; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
      bash build-essential ca-certificates curl file git jq less procps vim-tiny; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git init -q /app && git -C /app remote add origin "$REPO_URL" \
    && git -C /app fetch -q --depth 1 origin "$BASE_COMMIT" && git -C /app checkout -q --detach FETCH_HEAD \
    && test "$(git -C /app rev-parse HEAD)" = "$BASE_COMMIT" \
    && git -C /app remote remove origin && rm -f /app/.git/FETCH_HEAD
# The same dependency install as environment/Dockerfile (the repository's own uv.lock).
RUN set -eu; \
    pip install -q uv==0.12.23; \
    cd /app; \
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy \
      uv sync -q --frozen --all-extras --all-groups --python /usr/local/bin/python3.13; \
    rm -rf /root/.cache/uv; \
    chmod -R go-w /opt/venv; \
    test -z "$(git -C /app status --porcelain)"

# The grader's interpreter: root-owned, outside the repository, never on the submission's path.
COPY grader-requirements.txt /opt/dp-grader-requirements.txt
RUN set -eu; python -m venv /opt/dp-grader-venv; \
    /opt/dp-grader-venv/bin/pip install -q -r /opt/dp-grader-requirements.txt; \
    chmod -R go-w /opt/dp-grader-venv

COPY grader.py /tests/grader.py
COPY config.json /tests/config.json
COPY test.patch /tests/test.patch
COPY test.sh /tests/test.sh
COPY extract_base_pytest.py /tests/extract_base_pytest.py
RUN chmod +x /tests/test.sh && useradd --create-home --uid 1500 dpapp

# The base commit's lint and type-check configuration, pinned for the repository checks the runner
# runs besides the tests (run_repo_checks).
RUN set -eu; install -d -m 700 /opt/dp-base/lint; \
    cp /app/.ruff.toml /opt/dp-base/lint/ruff.toml; cp /app/pyproject.toml /opt/dp-base/lint/pyproject.toml; \
    chmod 600 /opt/dp-base/lint/*

# Check the staged hidden suite compiles, then restore the tree. After stage the tree is the base
# commit again, so pin-base pins the repo suite's pytest config, rootdir and plugins from it.
RUN set -eu; \
    git -C /app apply --whitespace=nowarn /tests/test.patch; \
    GRADE_DIR=/tmp/warm bash /app/test.sh stage; \
    GRADE_DIR=/tmp/warm bash /tmp/warm/test.sh pin-base; \
    chmod 600 /opt/dp-base/base-pytest.* /tests/extract_base_pytest.py; \
    GRADE_DIR=/tmp/warm bash /tmp/warm/test.sh build-tests; \
    rm -rf /tmp/warm; \
    git -C /app checkout -q -- .; git -C /app clean -qfd -- tests; \
    test -z "$(git -C /app status --porcelain)"

CMD ["/bin/bash"]
