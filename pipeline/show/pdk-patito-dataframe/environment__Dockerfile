FROM mirror.gcr.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

ARG REPO_URL=https://github.com/JakobGM/patito.git
ARG BASE_COMMIT=e4590c3508a2d716733df2353d95563a2f008a6f
ENV CI=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1

# tmux and asciinema are required by Harbor's solver agent.
RUN set -eu; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
      tmux asciinema bash build-essential ca-certificates curl file git jq less procps vim-tiny; \
    rm -rf /var/lib/apt/lists/*

# The repository at the base commit only: one commit, no remote, no reflog.
WORKDIR /app
RUN git init -q /app && git -C /app remote add origin "$REPO_URL" \
    && git -C /app fetch -q --depth 1 origin "$BASE_COMMIT" && git -C /app checkout -q --detach FETCH_HEAD \
    && test "$(git -C /app rev-parse HEAD)" = "$BASE_COMMIT" \
    && git -C /app remote remove origin && rm -f /app/.git/FETCH_HEAD \
    && git -C /app reflog expire --expire=now --all && git -C /app gc -q --prune=now

# The repository's own environment (uv.lock, all extras and groups, exported with
# `uv export --frozen --all-extras --all-groups --no-emit-project`), outside /app, with patito
# installed editable so changes under /app apply without a reinstall.
COPY requirements-lock.txt /tmp/requirements-lock.txt
RUN set -eu; python -m venv /opt/venv; \
    /opt/venv/bin/pip install -q -r /tmp/requirements-lock.txt; \
    /opt/venv/bin/pip install -q -e /app --no-deps; \
    rm -f /tmp/requirements-lock.txt
ENV PATH=/opt/venv/bin:$PATH

# Sample data, outside /app so it stays out of the repository.
COPY data/ /data/

CMD ["/bin/bash"]
