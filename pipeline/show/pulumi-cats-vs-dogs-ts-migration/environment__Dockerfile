# Agent image: the Terraform repository the team runs today (/workspace/terraform: modules, production
# terraform.tfstate, offline terraform with a provider mirror), the Pulumi project to write (/workspace/pulumi) and a
# local Pulumi backend (/workspace/pulumi-state) whose stack `dev` already holds every production resource, adopted
# by the platform team's bulk import. Offline toolchain: Pulumi CLI, the aws resource plugin and the TypeScript
# SDKs. No network at run time, no AWS credentials, nothing from the verifier (no reference program, no grader, no
# probes).
FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      asciinema bash ca-certificates curl git jq less procps tmux unzip util-linux vim-tiny xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Shared Pulumi toolchain layer (agent, verifier and authoring images): the pinned Pulumi CLI (its go, java, dotnet,
# yaml and bun language hosts removed; `pulumi` also linked into /usr/local/bin because a login shell - `bash -l`, a
# tmux pane - resets PATH from /etc/profile), the pinned aws resource plugin (installed per user below) and the Python
# SDKs from a fully pinned, hash-checked requirements file.
ARG PULUMI_VERSION=3.267.0
ARG PULUMI_SHA256=527c1ce7c16cb38525a96d55422f221e819476e2b0743ae55c9862ad775ae10a
ARG PULUMI_AWS_VERSION=6.83.0
ARG PULUMI_AWS_SHA256=0cb92a370deed22388612831e048aa882a00191aa5548b5e24c481c720d36e08
RUN set -eux; \
    curl -fsSLo /tmp/pulumi.tgz "https://get.pulumi.com/releases/sdk/pulumi-v${PULUMI_VERSION}-linux-x64.tar.gz"; \
    echo "${PULUMI_SHA256}  /tmp/pulumi.tgz" | sha256sum -c -; \
    tar -xzf /tmp/pulumi.tgz -C /opt; rm -f /tmp/pulumi.tgz; \
    rm -f /opt/pulumi/pulumi-language-go /opt/pulumi/pulumi-language-java /opt/pulumi/pulumi-language-dotnet \
          /opt/pulumi/pulumi-language-yaml /opt/pulumi/pulumi-language-bun; \
    ln -sf /opt/pulumi/pulumi /usr/local/bin/pulumi; \
    mkdir -p /opt/pulumi-plugins; \
    curl -fsSLo /opt/pulumi-plugins/aws.tgz \
      "https://get.pulumi.com/releases/plugins/pulumi-resource-aws-v${PULUMI_AWS_VERSION}-linux-amd64.tar.gz"; \
    echo "${PULUMI_AWS_SHA256}  /opt/pulumi-plugins/aws.tgz" | sha256sum -c -; \
    chmod -R a+rX /opt/pulumi /opt/pulumi-plugins
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt && rm -f /tmp/requirements.txt \
 && python3 -c "import pulumi, pulumi_aws; print('python sdks ok')"
ENV PATH=/opt/pulumi:$PATH \
    PULUMI_SKIP_UPDATE_CHECK=true \
    PULUMI_DISABLE_AUTOMATIC_PLUGIN_ACQUISITION=true

# Node.js (pinned release tarball) and the TypeScript toolchain installed once from a lock file with integrity hashes:
# @pulumi/pulumi, @pulumi/aws, typescript, ts-node and @types/node in /opt/pulumi-node/node_modules (projects link
# their node_modules to it; nothing is installed at run time).
ARG NODE_VERSION=22.23.3
ARG NODE_SHA256=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
RUN set -eux; \
    curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"; \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c -; \
    mkdir -p /opt/node; tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1; rm -f /tmp/node.tar.xz; \
    ln -sf /opt/node/bin/node /usr/local/bin/node; ln -sf /opt/node/bin/npm /usr/local/bin/npm; \
    ln -sf /opt/node/bin/npx /usr/local/bin/npx; node --version; npm --version
COPY node/package.json node/package-lock.json /opt/pulumi-node/
RUN set -eux; cd /opt/pulumi-node; \
    npm ci --no-audit --no-fund --loglevel=error --cache /tmp/npm-cache; rm -rf /tmp/npm-cache; \
    chmod -R a+rX /opt/pulumi-node; \
    node -e "require('@pulumi/pulumi'); require('@pulumi/aws'); console.log('node sdks ok')"; \
    /opt/pulumi-node/node_modules/.bin/tsc --version

# Terraform as the team runs it: the pinned CLI and the aws provider of the lock file in an offline filesystem mirror.
ARG TERRAFORM_VERSION=1.16.4
ARG TERRAFORM_SHA256=dc94af0eef1147718ad7c8daea792ed199e3e0492eec180d0adafa2a65a879df
ARG TF_AWS_VERSION=5.100.0
ARG TF_AWS_SHA256=1589a2266af699cbd5d80737a0fe02e54ec9cf2ca54e7e00ac51c7359056f274
RUN set -eux; \
    curl -fsSLo /tmp/terraform.zip "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip"; \
    echo "${TERRAFORM_SHA256}  /tmp/terraform.zip" | sha256sum -c -; \
    unzip -q /tmp/terraform.zip -d /usr/local/bin; rm -f /tmp/terraform.zip; \
    d=/opt/terraform/mirror/registry.terraform.io/hashicorp/aws/${TF_AWS_VERSION}/linux_amd64; mkdir -p "$d"; \
    curl -fsSLo /tmp/p.zip "https://releases.hashicorp.com/terraform-provider-aws/${TF_AWS_VERSION}/terraform-provider-aws_${TF_AWS_VERSION}_linux_amd64.zip"; \
    echo "${TF_AWS_SHA256}  /tmp/p.zip" | sha256sum -c -; unzip -q /tmp/p.zip -d "$d"; rm -f /tmp/p.zip; \
    chmod -R a+rX /opt/terraform; terraform version
COPY terraformrc /etc/terraformrc
ENV TF_CLI_CONFIG_FILE=/etc/terraformrc \
    CHECKPOINT_DISABLE=1 \
    AWS_EC2_METADATA_DISABLED=true

RUN groupadd --gid 1001 agent \
 && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash agent \
 && git config --system user.name "Cats vs Dogs Platform" \
 && git config --system user.email "platform@cats-vs-dogs.example" \
 && git config --system init.defaultBranch main \
 && git config --system --add safe.directory '*' \
 && mkdir -p /workspace && chown agent:agent /workspace

COPY --chown=agent:agent workspace/ /workspace/
COPY --chown=agent:agent production-stack.json.gz /tmp/production-stack.json.gz

# No AWS access: AWS calls go to a dead loopback endpoint and other traffic to a dead loopback proxy, so anything that
# tries the network fails at once instead of hanging on retries. Loopback itself (the Pulumi engine's gRPC) is exempt.
ENV AWS_ENDPOINT_URL=http://127.0.0.1:9 \
    AWS_ACCESS_KEY_ID=offline-sandbox AWS_SECRET_ACCESS_KEY=offline-sandbox AWS_DEFAULT_REGION=us-east-1 \
    HTTPS_PROXY=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9 https_proxy=http://127.0.0.1:9 \
    http_proxy=http://127.0.0.1:9 \
    NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost no_grpc_proxy=127.0.0.1,localhost

USER agent
ENV PULUMI_HOME=/home/agent/.pulumi \
    PULUMI_BACKEND_URL=file:///workspace/pulumi-state \
    PULUMI_CONFIG_PASSPHRASE=cats-vs-dogs-dev
# The aws plugin in the agent's plugin cache; the bulk-imported production stack in the local backend; the repository
# as the team has it (one commit); terraform initialised from the mirror. No terraform plan here: a RUN step runs
# under docker-default AppArmor, and a filesystem unix socket there (terraform's plugin RPC; a tmux server) can panic
# the build host's kernel (7.0.0-1013-gcp); iacctl build already proved the clean plan.
RUN set -eux; \
    pulumi plugin install resource aws 6.83.0 -f /opt/pulumi-plugins/aws.tgz; \
    gunzip -f /tmp/production-stack.json.gz; \
    mkdir -p /workspace/pulumi-state; cd /workspace/pulumi; ln -s /opt/pulumi-node/node_modules node_modules; \
    pulumi stack init dev --non-interactive; \
    pulumi stack import -s dev --file /tmp/production-stack.json; \
    rm -f /tmp/production-stack.json; \
    pulumi preview --refresh=false --non-interactive -s dev > /tmp/preview.log 2>&1 || { cat /tmp/preview.log; exit 1; }; \
    grep -E "to delete|unchanged" /tmp/preview.log; rm -f /tmp/preview.log; \
    cd /workspace/terraform && terraform init -input=false -no-color >/dev/null; \
    cd /workspace && printf 'pulumi-state/\n__pycache__/\nnode_modules\n' > .gitignore \
      && git init -q && git add -A && git commit -q -m "Terraform stack; Pulumi project scaffold"; \
    tmux -V
USER root
WORKDIR /workspace/pulumi
