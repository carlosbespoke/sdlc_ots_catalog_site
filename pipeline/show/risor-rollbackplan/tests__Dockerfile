# syntax=docker/dockerfile:1
# Verifier image (Harbor separate-verifier mode), built from tests/. Harbor copies the agent's final
# /workdir in and runs /tests/test.sh as root. Grade-time assets live only here.

# --- Toolchain (kept verbatim in tests/Dockerfile) ---
FROM --platform=linux/amd64 golang@sha256:e401dae1bf814e29204a8cb7915682e1780951e609ca0dd8865ee1937f510c48
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV CGO_ENABLED=1 GOFLAGS=-buildvcs=false GOMODCACHE=/go/pkg/mod GOTOOLCHAIN=local SOURCE_DATE_EPOCH=0
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends build-essential ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash agent
RUN printf 'export CGO_ENABLED=1 GOFLAGS=-buildvcs=false GOMODCACHE=/go/pkg/mod GOCACHE=/home/agent/.cache/go-build GOTOOLCHAIN=local GOPROXY=off\nexport PATH="/usr/local/go/bin:/go/bin:$PATH"\n' \
        > /etc/profile.d/00-go.sh \
    && chmod 0644 /etc/profile.d/00-go.sh

# --- Agent harness prerequisites ---
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        asciinema ca-certificates git tmux \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man
RUN command -v git && command -v tmux && tmux -V \
    && tmux -L harbor-build-smoke new-session -d -s smoke 'sleep 30' \
    && tmux -L harbor-build-smoke has-session -t smoke \
    && tmux -L harbor-build-smoke kill-server

# --- rca:source begin (rendered by `rca regen` from rca-task.json; verbatim in tests/Dockerfile) ---
ARG RCA_REPOSITORY=https://github.com/deepnoodle-ai/risor.git
ARG RCA_COMMIT=a263ecce1b9d58c71e2147d9ed087288588c79de
RUN git init -q /workdir && cd /workdir \
    && git fetch -q --depth 1 "$RCA_REPOSITORY" "$RCA_COMMIT" \
    && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$RCA_COMMIT" \
    && rm -rf .git .github .coderabbit.yaml CLAUDE.md llms.txt
COPY faults/ /workdir/
# --- rca:source end ---

# --- Verifier ---
# Modules from a scratch copy of the pristine tree (the project itself is never installed), then
# move the pristine tree aside; /workdir stays empty in the image.
RUN cp -r /workdir /tmp/moddl && cd /tmp/moddl && go mod download all && rm -rf /tmp/moddl
ENV GOPROXY=off GOSUMDB=off GOFLAGS="-buildvcs=false -mod=readonly" GOMEMLIMIT=1GiB GOMAXPROCS=4
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends procps util-linux \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/rca && mv /workdir /opt/rca/pristine && mkdir -p /workdir /logs/verifier
COPY . /tests
RUN rm -f /tests/Dockerfile \
    && chown -R root:root /tests /opt/rca \
    && chmod -R go-rwx /tests /opt/rca
RUN python3 -I -S /tests/grade.py --prepare && rm -rf /tests/__pycache__
WORKDIR /workdir
CMD ["sh", "-c", "sleep infinity"]
