# syntax=docker/dockerfile:1
# Verifier image (Harbor separate-verifier mode). Built from tests/ after the agent finishes.
# Harbor starts it as a fresh container, copies the agent's final /workdir in (task.toml
# `artifacts`), bind-mounts /logs/verifier and runs /tests/test.sh as root. The agent's container
# is stopped by then and never receives anything from tests/.
#
# The toolchain section repeats environment/Dockerfile's interpreter and dependency layers
# verbatim, so the candidate is observed with the interpreter and libraries it was written
# against. Keep the two in step: `separate-verifier.py parity` compares the built images.
# Change environment/Dockerfile only when the solver really needs it; its bytes key the QC cache.

# --- Toolchain (from environment/Dockerfile) ---
# scrapy-pdk-ots. /workdir carries scrapy/scrapy at ca48915dd4f6c388be741a97213df03e7a81ea89 with its
# documentation curation and the selected implementation drift already applied; the tree is shipped in this
# build context (environment/solver).
# Runtime has no network: everything solve-time and grade-time is installed here with exact versions.
# Base image and dependency set are the colleague original's (pdk-drift-repository-50473d7eeee6 v1): the same
# Python 3.11 image digest and the exact versions its image's `pip install -e .` plus test-tool installs
# resolved to (its `pip freeze`). Scrapy itself is not installed: /workdir is on PYTHONPATH and a small
# `scrapy` launcher runs `python -m scrapy`, which is what the original's console script did.
FROM python@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 PIP_NO_CACHE_DIR=1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=0
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/workdir
ENV SOURCE_DATE_EPOCH=0

# --- Agent harness prerequisites (driftflow/harness.py, ISSUE-103) ---
# Harbor's agent opens a tmux session in this container and drives the solver through it.
# Without tmux every rollout dies at agent setup. Debian ships *.patch files under
# /usr/share/doc, which isolation probes that walk the filesystem flag; drop the docs here.
# The build libraries are the original's.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        asciinema build-essential ca-certificates curl git libffi-dev libfreetype6-dev libjpeg-dev libssl-dev \
        libxml2-dev libxslt1-dev pkg-config tmux zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man
# Fail the BUILD, not a paid cohort.
RUN command -v git && command -v tmux \
    && tmux -V \
    && tmux -L harbor-build-smoke new-session -d -s smoke 'sleep 30' \
    && tmux -L harbor-build-smoke has-session -t smoke \
    && tmux -L harbor-build-smoke kill-server

# Keep the toolchain visible to login shells (`bash -lc`), not just `ENV`.
RUN printf 'export VIRTUAL_ENV="/opt/venv"\nexport PATH="/opt/venv/bin:$PATH"\nexport PYTHONPATH="/workdir"\nexport PYTHONDONTWRITEBYTECODE="1"\nexport PYTHONHASHSEED="0"\nexport TZ="UTC"\n' \
      > /etc/profile.d/00-scrapy.sh && chmod 0644 /etc/profile.d/00-scrapy.sh

RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir 'pip==25.2' 'setuptools==75.8.2' 'wheel==0.45.1'

# --- Dependencies: the original image's `pip freeze` (minus the editable Scrapy itself), installed without
# resolution and then checked for consistency.
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps \
        'anyio==4.15.1' 'attrs==26.1.0' 'Automat==25.4.16' 'brotli==1.2.0' 'certifi==2026.7.22' \
        'cffi==2.1.1' 'charset-normalizer==3.5.2' 'constantly==23.10.4' 'coverage==7.16.2' \
        'cryptography==50.0.2' 'cssselect==1.5.0' 'decorator==5.3.1' 'defusedxml==0.7.1' \
        'execnet==2.1.2' 'filelock==4.0.9' 'greenlet==3.5.6' 'h11==0.16.0' 'httpcore2==2.13.1' \
        'httpx2==2.13.1' 'hyperlink==21.0.0' 'idna==3.20' 'Incremental==24.11.0' 'iniconfig==2.3.0' \
        'itemadapter==0.13.1' 'itemloaders==1.5.0' 'jmespath==1.1.0' 'lxml==6.1.3' 'packaging==26.3' \
        'parsel==1.12.1' 'pexpect==4.9.0' 'pluggy==1.6.0' 'Protego==0.7.0' 'ptyprocess==0.7.0' \
        'pycparser==3.0' 'PyDispatcher==2.0.7' 'pyftpdlib==2.2.0' 'Pygments==2.21.0' \
        'pyOpenSSL==26.4.0' 'pytest==9.1.1' 'pytest-cov==7.1.0' 'pytest-rerunfailures==16.7' \
        'pytest-timeout==2.4.0' 'pytest-twisted==1.14.3' 'pytest-xdist==3.8.0' 'queuelib==1.10.0' \
        'requests==2.34.2' 'requests-file==3.0.1' 'service-identity==26.1.0' 'sybil==10.1.0' \
        'tldextract==5.3.2' 'truststore==0.10.4' 'Twisted==26.4.0' 'typing_extensions==4.16.0' \
        'urllib3==2.8.0' 'w3lib==2.5.0' 'zope.interface==8.6' \
    && /opt/venv/bin/python -m pip check \
    && rm -rf /root/.cache /tmp/* /var/tmp/* \
    && find /opt/venv -depth \( -name __pycache__ -o -name '*.pyc' \) -exec rm -rf -- {} +

# The `scrapy` command, as the original's console script provided it.
RUN printf '#!/bin/sh\nexec /opt/venv/bin/python -m scrapy "$@"\n' > /usr/local/bin/scrapy \
    && chmod 0755 /usr/local/bin/scrapy

RUN useradd -m -u 1000 -s /bin/bash agent 2>/dev/null || true \
    && git config --system --add safe.directory /workdir

# --- Verifier ---
# No extra packages: the grader's observation children import the candidate's `scrapy` package from a staged
# copy of /workdir (appended after the standard library and site-packages) with the same interpreter and
# libraries as the solver image. Seal that interpreter as the solver image does: keep the venv root-owned and
# not group/other-writable.
RUN chown -R root:root /opt/venv \
    && chmod -R go-w /opt/venv \
    && /opt/venv/bin/python -c "import twisted, lxml, parsel, w3lib, queuelib, protego, brotli; print('verifier interpreter sealed')"

# The grader, its private material and the reward writer, root-only: candidate code that the
# grader runs as an unprivileged user must not read them. /workdir stays empty in the image;
# it arrives as the agent's artifact.
COPY . /tests
RUN rm -f /tests/Dockerfile \
    && chown -R root:root /tests \
    && chmod -R go-rwx /tests \
    && mkdir -p /workdir /logs/verifier

WORKDIR /workdir
CMD ["sh", "-c", "sleep infinity"]
