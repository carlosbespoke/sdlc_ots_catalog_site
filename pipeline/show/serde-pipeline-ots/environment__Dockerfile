# spec-drift-ots Rust task image for serde-rs/serde@747814f7d5fbab872df3b02f070c165b91bde062. /workdir is environment/solver/:
# the curated tree with the drift applied.
FROM rust:1.97-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS toolchain
# The official image ships CARGO_HOME and RUSTUP_HOME world-writable (chmod -R a+w): seal them in
# a throwaway stage and copy them once, instead of a chmod layer that duplicates ~860 MB.
RUN chmod -R go-w /usr/local/cargo /usr/local/rustup

FROM buildpack-deps:bookworm@sha256:b22578185ebfdbd9a4050f697638b9c9696b70616d9b01bddfa79145db2b6dfd
COPY --from=toolchain /usr/local/rustup /usr/local/rustup
COPY --from=toolchain /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH \
    LANG=C.UTF-8 LC_ALL=C.UTF-8 CARGO_TERM_COLOR=never CARGO_TERM_PROGRESS_WHEN=never

# --- Agent harness prerequisites (driftflow/harness.py, ISSUE-103) ---
# Harbor's TerminusV2 agent opens a tmux session in this container, records it, and drives
# the solver through it. Without tmux every rollout dies at agent setup with "Failed to start
# tmux session" before the agent takes a turn, and the whole cohort is lost. Nothing else in
# the local gates notices, because none of them starts the real agent.
#
# This layer needs build-time network for the package manager. Build with network enabled;
# that is independent of the task's run-time isolation, which task.toml still declares as
# no-network. Keep the base image digest-pinned.
#
# Debian ships *.patch files under /usr/share/doc, which isolation probes that walk the
# filesystem for private assets will flag. Drop the docs here rather than loosening a probe.
RUN if command -v apt-get >/dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends \
            asciinema ca-certificates git tmux \
        && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man; \
    elif command -v apk >/dev/null; then \
        apk add --no-cache asciinema ca-certificates git tmux; \
    fi
# Fail the BUILD, not a paid cohort. Starting and tearing down a real session proves tmux
# works, which `command -v` does not.
RUN command -v git && command -v tmux \
    && tmux -V \
    && tmux -L harbor-build-smoke new-session -d -s smoke 'sleep 30' \
    && tmux -L harbor-build-smoke has-session -t smoke \
    && tmux -L harbor-build-smoke kill-server
RUN useradd -m -u 1000 -s /bin/bash agent && mkdir -p /workspace/target \
    && chown agent:agent /workspace/target \
    && printf 'export CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup CARGO_TARGET_DIR=/workspace/target CARGO_TERM_COLOR=never PATH="/usr/local/cargo/bin:$PATH"\n' > /etc/profile.d/00-spec-drift.sh
ENV CARGO_TARGET_DIR=/workspace/target RUST_BACKTRACE=1
# The solver's starting state: the curated tree with the drift applied.
COPY solver /workdir
COPY spec-drift.lock /opt/spec-drift/Cargo.lock
RUN set -eu; cd /workdir; cp /opt/spec-drift/Cargo.lock Cargo.lock; cargo vendor --locked --versioned-dirs /opt/spec-drift/vendor > /tmp/vendor.toml; rm Cargo.lock; { cat /tmp/vendor.toml; printf '\n[net]\noffline = true\n'; } > /usr/local/cargo/config.toml; chmod 0644 /usr/local/cargo/config.toml; mkdir -p /opt/spec-drift/vendor; cp -a /workdir /tmp/pin-check; (cd /tmp/pin-check && cargo generate-lockfile --offline -q); for f in /opt/spec-drift/Cargo.lock /tmp/pin-check/Cargo.lock; do awk '/^name = /{n=$3} /^version = /{print n" "$3}' $f | sort > $f.pv; done; diff /opt/spec-drift/Cargo.lock.pv /tmp/pin-check/Cargo.lock.pv; rm -f /opt/spec-drift/Cargo.lock.pv; rm -rf /usr/local/cargo/registry /usr/local/cargo/git /root/.cargo; rm -rf /tmp/* /var/tmp/*; chown -R root:root /opt/spec-drift; chmod -R go-w,a+rX /opt/spec-drift
# Pre-build the delivered tree's dependencies into the agent's build folder, from a copy: a build
# in /workdir would write a Cargo.lock into the sanitized tree.
RUN cp -a /workdir /tmp/prebuild && chown -R agent:agent /tmp/prebuild
USER agent
RUN cd /tmp/prebuild && (cargo build --offline --workspace --all-targets -q || cargo build --offline --workspace -q)
USER root
RUN rm -rf /tmp/prebuild /workdir/.git /workdir/target \
    && find /workdir -exec touch -h -d "2001-01-01T00:00:00Z" {} + \
    && chmod -R g-w,o-w /workdir
# A sanitized repository initialised from the solver starting state only: one commit, no remotes,
# no tags, no reflog, nothing that could expose the curated baseline or the answer.
RUN set -eu; \
    cd /workdir; \
    git init -q -b main --object-format=sha1; \
    git config core.logAllRefUpdates false; \
    git config core.pager cat; \
    git config gc.auto 0; \
    git add -A -f; \
    GIT_AUTHOR_NAME=task GIT_AUTHOR_EMAIL=task@example.invalid \
    GIT_COMMITTER_NAME=task GIT_COMMITTER_EMAIL=task@example.invalid \
    GIT_AUTHOR_DATE=2001-01-01T00:00:00Z GIT_COMMITTER_DATE=2001-01-01T00:00:00Z \
        git -c commit.gpgsign=false commit -qm "Initial state"; \
    test "$(git rev-list --all --count)" = 1; \
    test "$(git for-each-ref --format='%(refname)')" = refs/heads/main; \
    test -z "$(git remote)"; \
    test -z "$(git tag --list)"; \
    test -z "$(git stash list)"; \
    test -z "$(git reflog --all)"; \
    git diff --quiet; \
    git diff --cached --quiet; \
    test -z "$(git status --porcelain --untracked-files=all)"; \
    test -z "$(git fsck --strict --no-progress --no-reflogs --unreachable 2>&1)"; \
    git read-tree --reset HEAD; \
    chown -R agent:agent /workdir
USER agent
WORKDIR /workdir
CMD ["bash", "-lc", "sleep infinity"]
