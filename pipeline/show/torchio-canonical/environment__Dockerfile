# syntax=docker/dockerfile:1
# torchio-canonical. /workdir carries TorchIO-project/torchio at
# 2b019d2a9659c838408c73ae77327ac5eb87b190 (TorchIO 2.0.0a2) with its documentation curation and the selected
# implementation drift already applied; the tree is shipped in this build context so the image needs no repository
# fetch. Runtime has no network: everything solve-time and grade-time is installed here with exact versions.
FROM python@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 PIP_NO_CACHE_DIR=1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONHASHSEED=42
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/workdir/src
ENV SOURCE_DATE_EPOCH=0
ENV OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLBACKEND=Agg

# --- Agent harness prerequisites (driftflow/harness.py, ISSUE-103) ---
# Harbor's TerminusV2 agent opens a tmux session in this container, records it, and drives
# the solver through it. Without tmux every rollout dies at agent setup with "Failed to start
# tmux session" before the agent takes a turn, and the whole cohort is lost. Nothing else in
# the local gates notices, because none of them starts the real agent.
#
# This layer needs build-time network for the package manager. Build with network enabled;
# that is independent of the task's run-time isolation, which task.toml still declares as
# no-network. Keep the base image digest-pinned.
#
# Debian ships *.patch files under /usr/share/doc, which isolation probes that walk the
# filesystem for private assets will flag. Drop the docs here rather than loosening a probe.
RUN if command -v apt-get >/dev/null; then \
        apt-get update && apt-get install -y --no-install-recommends \
            asciinema ca-certificates git tmux \
        && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man; \
    elif command -v apk >/dev/null; then \
        apk add --no-cache asciinema ca-certificates git tmux; \
    fi
# Fail the BUILD, not a paid cohort. Starting and tearing down a real session proves tmux
# works, which `command -v` does not.
RUN command -v git && command -v tmux \
    && tmux -V \
    && tmux -L harbor-build-smoke new-session -d -s smoke 'sleep 30' \
    && tmux -L harbor-build-smoke has-session -t smoke \
    && tmux -L harbor-build-smoke kill-server

# Keep the toolchain visible to login shells (`bash -lc`), not just `ENV`: /etc/profile rebuilds
# PATH and would otherwise discard the ENV entry.
RUN printf 'export VIRTUAL_ENV="/opt/venv"\nexport PATH="/opt/venv/bin:$PATH"\nexport PYTHONPATH="/workdir/src"\nexport PYTHONDONTWRITEBYTECODE="1"\nexport PYTHONHASHSEED="42"\nexport TZ="UTC"\nexport OMP_NUM_THREADS="1"\nexport MKL_NUM_THREADS="1"\nexport MPLBACKEND="Agg"\n' \
      > /etc/profile.d/00-torchio.sh && chmod 0644 /etc/profile.d/00-torchio.sh

RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir 'pip==25.0.1' 'setuptools==80.9.0' 'wheel==0.45.1'

# --- Solve-time dependencies: the runtime requirements of torchio (einops, fsspec[http], humanize, jaxtyping,
# loguru, nibabel, numpy, platformdirs, rich, SimpleITK, torch (CPU build), torch-interpol, typing_extensions, tyro),
# the optional NIfTI-Zarr backend (nifti-zarr, zarr<3.2), the plotting extra (matplotlib, colorcet) and pytest with
# pytest-xdist so the solver can run tests of its own, resolved as of the pinned commit's date
# (uv pip compile --python-version 3.12 --exclude-newer 2026-07-22, torch from the PyTorch CPU index).
# torchio itself is not installed: it is imported from /workdir/src through PYTHONPATH.
RUN /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
        'aiohappyeyeballs==2.7.1' \
        'aiohttp==3.14.2' \
        'aiosignal==1.4.0' \
        'attrs==26.1.0' \
        'click==8.4.2' \
        'cloudpickle==3.1.2' \
        'colorcet==3.2.1' \
        'contourpy==1.3.3' \
        'cycler==0.12.1' \
        'dask==2026.7.1' \
        'docstring-parser==0.18.0' \
        'donfig==0.8.1.post1' \
        'einops==0.8.2' \
        'execnet==2.1.2' \
        'filelock==3.32.0' \
        'fonttools==4.63.0' \
        'frozenlist==1.8.0' \
        'fsspec==2026.6.0' \
        'google-crc32c==1.8.0' \
        'humanize==4.16.0' \
        'idna==3.18' \
        'imageio==2.37.4' \
        'iniconfig==2.3.0' \
        'jaxtyping==0.3.11' \
        'jinja2==3.1.6' \
        'kiwisolver==1.5.0' \
        'lazy-loader==0.5' \
        'locket==1.0.0' \
        'loguru==0.7.3' \
        'markdown-it-py==4.2.0' \
        'markupsafe==3.0.3' \
        'matplotlib==3.11.1' \
        'mdurl==0.1.2' \
        'mpmath==1.3.0' \
        'multidict==6.7.1' \
        'networkx==3.6.1' \
        'nibabel==5.4.2' \
        'nifti-zarr==1.0.0rc7' \
        'numcodecs==0.16.5' \
        'numpy==2.5.1' \
        'packaging==26.2' \
        'partd==1.4.2' \
        'pillow==12.3.0' \
        'platformdirs==4.11.0' \
        'pluggy==1.6.0' \
        'propcache==0.5.2' \
        'pygments==2.20.0' \
        'pyparsing==3.3.2' \
        'pytest==9.1.1' \
        'pytest-xdist==3.8.0' \
        'python-dateutil==2.9.0.post0' \
        'pyyaml==6.0.3' \
        'rich==15.0.0' \
        'scikit-image==0.26.0' \
        'scipy==1.18.0' \
        'setuptools==83.0.0' \
        'simpleitk==2.5.5' \
        'six==1.17.0' \
        'sympy==1.14.0' \
        'tifffile==2026.7.14' \
        'toolz==1.1.0' \
        'torch==2.13.0+cpu' \
        'torch-interpol==0.3.0' \
        'typeguard==4.5.2' \
        'typing-extensions==4.16.0' \
        'tyro==1.0.15' \
        'wadler-lindig==0.1.7' \
        'yarl==1.24.5' \
        'zarr==3.1.6' \
        && true

# torchio/__init__.py reads its version with importlib.metadata.version("torchio"). The package is imported
# from /workdir/src, not installed, so register metadata only (pyproject.toml's version, no files and no path
# entry) for that lookup.
RUN d=$(/opt/venv/bin/python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])")/torchio-2.0.0a2.dist-info \
    && mkdir -p "$d" \
    && printf 'Metadata-Version: 2.1\nName: torchio\nVersion: 2.0.0a2\n' > "$d/METADATA" \
    && printf 'pip\n' > "$d/INSTALLER" \
    && : > "$d/RECORD" \
    && /opt/venv/bin/python -c "from importlib.metadata import version; assert version('torchio') == '2.0.0a2'"

RUN useradd -m -u 1000 -s /bin/bash agent 2>/dev/null || true \
    && git config --system --add safe.directory /workdir

# The solver starting state. Only this directory is copied into the image: the reusable baseline
# declaration and its documentation-curation patch stay in the build context.
COPY solver /workdir

WORKDIR /workdir
RUN find /workdir -depth \( -name __pycache__ -o -name '*.pyc' -o -name .pytest_cache \) -exec rm -rf -- {} + \
    && find /workdir -exec touch -h -d "2001-01-01T00:00:00Z" {} + 2>/dev/null || true
RUN chmod -R g-w,o-w /workdir
# A sanitized repository initialised from the solver starting state only: one commit, no remotes,
# no tags, no reflog, nothing that could expose the clean baseline or the answer.
RUN set -eu; \
    cd /workdir; \
    git init -q -b main --object-format=sha1; \
    git config core.logAllRefUpdates false; \
    git config core.pager cat; \
    git config gc.auto 0; \
    git add -A -f; \
    GIT_AUTHOR_NAME=task GIT_AUTHOR_EMAIL=task@example.invalid \
    GIT_COMMITTER_NAME=task GIT_COMMITTER_EMAIL=task@example.invalid \
    GIT_AUTHOR_DATE=2001-01-01T00:00:00Z GIT_COMMITTER_DATE=2001-01-01T00:00:00Z \
        git -c commit.gpgsign=false commit -qm "Initial state"; \
    test "$(git rev-list --all --count)" = 1; \
    test "$(git for-each-ref --format='%(refname)')" = refs/heads/main; \
    test -z "$(git remote)"; \
    test -z "$(git tag --list)"; \
    test -z "$(git stash list)"; \
    test -z "$(git reflog --all)"; \
    git diff --quiet; \
    git diff --cached --quiet; \
    test -z "$(git status --porcelain --untracked-files=all)"; \
    test -z "$(git fsck --strict --no-progress --no-reflogs --unreachable 2>&1)"; \
    git read-tree --reset HEAD; \
    chown -R agent:agent /workdir

# Smoke-check the solver's view: torchio and every in-scope module import from /workdir/src.
RUN cd /tmp && HOME=/tmp /opt/venv/bin/python -W ignore - <<'PY'
import importlib, pathlib
root = pathlib.Path('/workdir/src')
skip = ('torchio/datasets/', 'torchio/external/', 'torchio/download.py', 'torchio/visualization.py',
        'torchio/cli.py', 'torchio/transforms/monai_adapter.py', 'torchio/transforms/cornucopia_adapter.py')
names = sorted('.'.join(p.relative_to(root).with_suffix('').parts).removesuffix('.__init__')
               for p in (root / 'torchio').rglob('*.py')
               if not p.relative_to(root).as_posix().startswith(skip))
for name in names:
    module = importlib.import_module(name)
    assert module.__file__.startswith('/workdir/src/torchio/'), (name, module.__file__)
import torch, torchio
image = torchio.ScalarImage(torch.zeros(1, 2, 3, 4))
print(len(names), 'torchio modules import from /workdir/src', torchio.__version__, tuple(image.shape))
PY

# --- Verifier dependencies -------------------------------------------------------------------
# The grader runs in its own image (tests/Dockerfile). Seal this interpreter as well: drop any .pth
# that would put /workdir on sys.path and keep the venv root-owned and unwritable by the agent.
RUN find /opt/venv -name '*.pth' -print0 | xargs -0 -r grep -l /workdir | xargs -r rm -f \
    && chown -R root:root /opt/venv \
    && chmod -R go-w /opt/venv \
    && /opt/venv/bin/python -c "import torch, numpy, SimpleITK, nibabel, einops, jaxtyping, loguru, rich, tyro, humanize, fsspec, interpol, zarr, niizarr; print('interpreter sealed')"
